{
  "_comment": "Project-level Claude Code settings starter. Copy to .claude/settings.json. Keep allow rules narrow: name the exact scripts agents run here.",
  "permissions": {
    "allow": [
      "Bash(pnpm run quality)",
      "Bash(pnpm test *)",
      "Bash(pnpm install)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/*.p12)",
      "Read(./**/.netrc)",
      "Read(./node_modules/**)",
      "Read(./target/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./data/**)",
      "Read(./renders/**)",
      "Read(./.venv/**)"
    ]
  }
}
