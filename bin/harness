                "plan-ceremony": "light", "testing": "off"},
}
# Identity fields whose example value is a placeholder rather than a value someone might mean.
# `pronouns: they/them` and `timezone: UTC` are real answers, so they are not checked.
PLACEHOLDER_IDENTITY_KEYS = ["name", "role", "github"]
PERSONAL_MARKER = "<!-- harness:personal-below -->"
