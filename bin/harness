    return Path(os.environ.get("CODEX_HOME", str(home() / ".codex")))


def global_gitignore_path() -> Path:
    return home() / ".config" / "git" / "ignore"


# --------------------------------------------------------------------------- io helpers


def read_json(path: Path) -> Optional[Dict[str, Any]]:
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{path} is not valid JSON ({exc}); fix it or remove it and re-run")


def write_json_atomic(path: Path, data: Dict[str, Any], expect_mtime: Optional[float] = None, backup: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if expect_mtime is not None and path.exists() and abs(path.stat().st_mtime - expect_mtime) > 1e-6:
        raise SystemExit(f"{path} changed while harness was running; nothing written. Re-run.")
    if backup and path.exists():
        shutil.copy2(path, path.with_suffix(path.suffix + ".bak"))
    tmp = path.with_name(path.name + ".harness-tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


def say(msg: str) -> None:
    if os.environ.get("HARNESS_QUIET"):
        return
    print(msg)


# --------------------------------------------------------------------------- config


def load_config(env: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
    env = os.environ if env is None else env
    base = read_json(REPO / "config.example.json") or {}
    user = read_json(config_path()) or {}
    cfg = deepcopy(base)
    for key, value in user.items():
        if isinstance(value, dict) and isinstance(cfg.get(key), dict):
            cfg[key].update(value)
        else:
            cfg[key] = value
    cfg.setdefault("stances", {})
    cfg.setdefault("identity", {})
    project_file = env.get("HARNESS_PROJECT_CONFIG")
    if project_file:
        project = read_json(Path(project_file).expanduser()) or {}
        if set(project) - {"stances"}:
            raise SystemExit("project config may select stances only; user config owns identity, targets and permissions")
        if not isinstance(project.get("stances", {}), dict):
            raise SystemExit("project stances must be an object")
        cfg["stances"].update(project.get("stances", {}))
    for key, value in env.items():
        if key.startswith("HARNESS_STANCE_"):
            cfg["stances"][key[len("HARNESS_STANCE_"):].lower().replace("_", "-")] = value
        elif key.startswith("HARNESS_IDENTITY_"):
            cfg["identity"][key[len("HARNESS_IDENTITY_"):].lower()] = value
        elif key == "HARNESS_PERMISSIONS":
            cfg["permissions"] = value
        elif key == "HARNESS_MANAGE_VSCODE":
            cfg.setdefault("vscode", {})["manage"] = value not in ("0", "false", "no")
        elif key == "HARNESS_MANAGE_CODEX":
            cfg.setdefault("codex", {})["manage"] = value not in ("0", "false", "no")
    return cfg


def example_config() -> Dict[str, Any]:
    return read_json(REPO / "config.example.json") or {}


def stance_variants(name: str) -> List[str]:
    return sorted(p.stem for p in (REPO / "primitives" / "stances" / name).glob("*.md"))


def placeholder_identity(cfg: Dict[str, Any]) -> List[str]:
    """Identity fields still carrying the example file's value.

    `load_config` falls back to `config.example.json` for anything the user's config omits, and
    `render_personal` writes whatever it resolves into `~/.claude/CLAUDE.personal.md`, which is
    always-loaded context. An unedited config therefore has the agent address you by a
    placeholder name and believe a placeholder role, with nothing on screen to say so.
    """
    example = example_config().get("identity", {})
    resolved = cfg.get("identity", {})
    return [k for k in PLACEHOLDER_IDENTITY_KEYS
            if k in example and str(resolved.get(k, example[k])).strip() == str(example[k]).strip()]


def resolve_stances(cfg: Dict[str, Any]) -> Dict[str, Path]:
    try:
        return primitive_catalog.resolve_stances(REPO, cfg)
    except ValueError as exc:
        raise SystemExit(str(exc))


def posture(cfg: Dict[str, Any]) -> str:
    value = cfg.get("permissions", "inherit")
    if value not in ("inherit",) and value not in POSTURES:
        raise SystemExit(f"permissions must be inherit, bypass, auto or manual; got '{value}'")
    if value == "bypass" and cfg.get("permissions_bypass_acknowledged") is not True:
        raise SystemExit(
            "permissions=bypass turns off every permission prompt in Claude Code and VS Code and puts "
            "Codex in danger-full-access with no sandbox. Never use it on a machine that touches "
            "regulated or customer data. To confirm you mean it, set "
            "\"permissions_bypass_acknowledged\": true in ~/.config/agent-harness/config.json."
        )
    return value


# --------------------------------------------------------------------------- settings merge


def _hook_marker(entry: Dict[str, Any]) -> Optional[str]:
    for h in entry.get("hooks", []):
        m = re.search(r"# harness:([a-z0-9-]+)", h.get("command", ""))
        if m:
            return m.group(1)
    return None


def _is_harness_entry(entry: Dict[str, Any]) -> bool:
    if _hook_marker(entry):
        return True
    for h in entry.get("hooks", []):
        cmd = h.get("command", "")
        if any(b in cmd for b in HARNESS_HOOK_BASENAMES):
            return True
    return False


def merge_claude_settings(live: Dict[str, Any], template: Dict[str, Any], cfg: Dict[str, Any],
                          retired: Iterable[str] = ()) -> Dict[str, Any]:
    """`retired` names allow rules an earlier template added that this one no longer carries;
    they are removed so a rule withdrawn upstream does not outlive it in a user's settings."""
    out = deepcopy(live) if live else {}
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    owned = ownership.get("claude", {}).get("owned_keys", [])
    for key in owned:
        if key in template:
            out[key] = template[key]
    perms = out.setdefault("permissions", {})
    p = posture(cfg)
    if p != "inherit":
        perms["defaultMode"] = POSTURES[p]["claude"]
    allow = [r for r in perms.get("allow", []) if r not in set(retired)]
    for rule in template.get("permissions", {}).get("allow", []):
        if rule not in allow:
            allow.append(rule)
    perms["allow"] = allow
    hooks = out.setdefault("hooks", {})
    plan_variant = cfg["stances"].get("plan-ceremony")
    hook_ids = ownership.get("claude", {}).get("hook_ids", {})
    for event, entries in template.get("hooks", {}).items():
        kept = [e for e in hooks.get(event, []) if not _is_harness_entry(e)]
        for entry in entries:
            hid = _hook_marker(entry)
            spec = hook_ids.get(hid, {})
            if spec.get("stance") and cfg["stances"].get(spec["stance"]) != spec.get("variant"):
                continue
            kept.append(deepcopy(entry))
        if kept:
            hooks[event] = kept
        elif event in hooks:
            del hooks[event]
    # Drop harness entries from events the template no longer defines.
    for event in list(hooks.keys()):
        if event not in template.get("hooks", {}):
            hooks[event] = [e for e in hooks[event] if not _is_harness_entry(e)]
            if not hooks[event]:
                del hooks[event]
    if not hooks:
        out.pop("hooks", None)
    return out


def strip_claude_settings(live: Dict[str, Any], template: Dict[str, Any]) -> Dict[str, Any]:
    out = deepcopy(live) if live else {}
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    for key in ownership.get("claude", {}).get("owned_keys", []):
        out.pop(key, None)
    perms = out.get("permissions", {})
    if "allow" in perms:
        tmpl = set(template.get("permissions", {}).get("allow", []))
        perms["allow"] = [r for r in perms["allow"] if r not in tmpl]
    hooks = out.get("hooks", {})
    for event in list(hooks.keys()):
        hooks[event] = [e for e in hooks[event] if not _is_harness_entry(e)]
        if not hooks[event]:
            del hooks[event]
    if not hooks:
        out.pop("hooks", None)
    return out


def retired_allow_rules(applied: Dict[str, Any], template: Dict[str, Any]) -> List[str]:
    """Allow rules the last synced template carried that the current template has dropped."""
    previous = (applied.get("template") or {}).get("allow") or []
    current = set(template.get("permissions", {}).get("allow", []))
    return [r for r in previous if r not in current]


def claude_projection(settings: Dict[str, Any], template: Dict[str, Any]) -> Dict[str, Any]:
    """The slice of a settings file the harness cares about, for diffing."""
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    owned = ownership.get("claude", {}).get("owned_keys", [])
    proj: Dict[str, Any] = {"keys": {k: settings.get(k) for k in owned}}
    proj["defaultMode"] = settings.get("permissions", {}).get("defaultMode")
    proj["allow"] = sorted(settings.get("permissions", {}).get("allow", []))
    proj["hooks"] = sorted(
        h for entries in settings.get("hooks", {}).values() for e in entries for h in [_hook_marker(e)] if h
    )
    return proj


def merge_vscode_settings(live: Dict[str, Any], owned: Dict[str, Any], cfg: Dict[str, Any]) -> Dict[str, Any]:
    out = deepcopy(live) if live else {}
    out.update(owned)
    p = posture(cfg)
    if p != "inherit":
        mode = POSTURES[p]["vscode"]
        if mode is None:
            out.pop("claudeCode.initialPermissionMode", None)
        else:
            out["claudeCode.initialPermissionMode"] = mode
        out["claudeCode.allowDangerouslySkipPermissions"] = (p == "bypass")
    return out


# --------------------------------------------------------------------------- links


class InstallManifest(dict):
    """Persist link/adoption intent before each filesystem mutation."""
    def persist(self):
        write_json_atomic(manifest_path(), self)


def _record(manifest: Dict[str, Any], kind: str, item: Dict[str, Any]) -> None:
    manifest.setdefault(kind, [])
    manifest[kind] = [i for i in manifest[kind] if i.get("path") != item.get("path")]
    manifest[kind].append(item)
    if isinstance(manifest, InstallManifest):
        manifest.persist()


def _adopt(path: Path, manifest: Dict[str, Any], dry: bool) -> Optional[Path]:
    """Move a pre-existing unmanaged path aside so the harness can link there."""
    dest_dir = state_dir() / "pre-harness"
    try:
        rel = path.relative_to(home())
    except ValueError:
        rel = Path("external") / hashlib.sha256(str(path).encode()).hexdigest() / path.name
    dest = dest_dir / rel
    say(f"  adopt   {path}  ->  {dest}")
    if not dry:
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.exists() or dest.is_symlink():
            dest = dest.with_name(dest.name + f".{int(time.time())}")
        _record(manifest, "adopted", {"path": str(path), "moved_to": str(dest)})
        shutil.move(str(path), str(dest))
    return dest


def ensure_link(path: Path, target: Path, manifest: Dict[str, Any], dry: bool, adopt: bool, report: List[str]) -> None:
    managed = any(l.get("path") == str(path) for l in manifest.get("links", []))
    if path.is_symlink():
        current = Path(os.readlink(path))
        if current == target or path.resolve() == target.resolve():
            _record(manifest, "links", {"path": str(path), "target": str(target)})
            return
        previous = next((entry for entry in manifest.get("links", []) if entry["path"] == str(path)), None)
        if previous and str(current) not in (previous["target"], previous.get("pending_from")):
            report.append(f"{path} was redirected after sync; preserving the user's link")
            return
        if managed or adopt:
            say(f"  relink  {path}")
            if not dry:
                _record(manifest, "links", {"path": str(path), "target": str(target), "pending_from": str(current)})
                path.unlink()
                path.symlink_to(target)
            _record(manifest, "links", {"path": str(path), "target": str(target)})
            return
        report.append(f"{path} is a symlink to {current}, not managed by the harness; pass --adopt to replace it")
        return
    if path.exists():
        if adopt:
            _adopt(path, manifest, dry)
        else:
            report.append(f"{path} exists and is not a harness link; pass --adopt to move it aside")
            return
    say(f"  link    {path}  ->  {target}")
    _record(manifest, "links", {"path": str(path), "target": str(target)})
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)


def link_dir_files(source: Path, dest: Path, manifest: Dict[str, Any], dry: bool, adopt: bool,
                   report: List[str]) -> None:
    """One link per file, so anything the user keeps in the destination directory survives."""
    wanted = set()
    if source.is_dir():
        for f in sorted(p_ for p_ in source.iterdir() if p_.is_file()):
            link = dest / f.name
            wanted.add(str(link))
            ensure_link(link, f, manifest, dry, adopt, report)
    for old in list(manifest.get("links", [])):
        if Path(old["path"]).parent == dest and old["path"] not in wanted:
            say(f"  unlink  {old['path']} (no longer in the harness)")
            path = Path(old["path"])
            if path.is_symlink() and os.readlink(path) != old["target"]:
                report.append(str(path) + ": retired link was redirected; preserved")
                continue
            if not dry and path.is_symlink():
                path.unlink()
            manifest["links"].remove(old)


def adopt_legacy(path: Path, manifest: Dict[str, Any], dry: bool, adopt: bool, report: List[str]) -> None:
    """A plain file the harness now supplies elsewhere; move it aside so it does not load twice."""
    if not path.exists() or path.is_symlink():
        return
    if adopt:
        _adopt(path, manifest, dry)
    else:
        report.append(f"{path} duplicates a harness file and would load twice; pass --adopt to move it aside")


# --------------------------------------------------------------------------- personal file, codex, gitignore


def render_personal(cfg: Dict[str, Any], existing: Optional[str]) -> str:
    template = (REPO / "claude" / "CLAUDE.personal.template.md").read_text(encoding="utf-8")
    identity = {k: cfg.get("identity", {}).get(k, "") for k in IDENTITY_KEYS}
    identity["guidance"] = GUIDANCE.get(identity.get("expertise") or "expert", GUIDANCE["expert"])
    head = template.format_map(identity)
    if existing and PERSONAL_MARKER in existing:
        tail = existing.split(PERSONAL_MARKER, 1)[1]
        head = head.split(PERSONAL_MARKER, 1)[0] + PERSONAL_MARKER + tail
    return head


def render_codex_agents(stances: Dict[str, Path], personal: Optional[str]) -> str:
    parts = [CODEX_BANNER, ""]
    parts += [(REPO / "primitives" / "instructions.md").read_text().rstrip(), ""]
    for rule in sorted((REPO / "primitives" / "rules").glob("*.md")):
        parts += ["---", f"<!-- {rule.name} -->", rule.read_text(encoding="utf-8").rstrip(), ""]
    for name, path in stances.items():
        parts += ["---", f"<!-- stance {name}: {path.stem} -->", path.read_text(encoding="utf-8").rstrip(), ""]
    if stances.get("voice") and stances["voice"].stem == "scannable":
        parts += ["Shared presentation: before composing a final response, read and apply `" +
                  str(REPO / "primitives" / "presentation" / "scannable.md") + "`.", ""]
    if personal:
        parts += ["---", "<!-- AGENTS.personal.md -->", personal.rstrip(), ""]
    return "\n".join(parts)


def update_codex_config(text: str, cfg: Dict[str, Any]) -> str:
    wanted = {"project_doc_fallback_filenames": ["CLAUDE.md"]}
    p = posture(cfg)
    if p != "inherit":
        approval, sandbox = POSTURES[p]["codex"]
        wanted.update(approval_policy=approval, sandbox_mode=sandbox)
        if p != "bypass":
            wanted["approval_reviewer"] = "auto_review" if p == "auto" else "user"
    return reconcile.update_toml(text, wanted)


def ensure_gitignore_entries(dry: bool) -> None:
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    entries = ownership.get("gitignore_entries", [])
    path = global_gitignore_path()
    existing = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    missing = [e for e in entries if e not in existing]
    if not missing:
        return
    say(f"  ignore  {path}: + {', '.join(missing)}")
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            if existing and existing[-1] != "":
                fh.write("\n")
            fh.write(IGNORE_MARKER + "\n" + "\n".join(missing) + "\n")


PATH_BLOCK = '# agent-harness: Claude Code native launcher lives here\nexport PATH="$HOME/.local/bin:$PATH"\n'
IGNORE_MARKER = "# agent-harness"


def remove_local_bin_from_path() -> bool:
    """Undo ensure_local_bin_on_path: drop the exact block sync appended, nothing else."""
    f = home() / ".zprofile"
    if not f.exists():
        return False
    text = f.read_text(encoding="utf-8")
    if PATH_BLOCK not in text:
        return False
    f.write_text(text.replace("\n" + PATH_BLOCK, "\n", 1).replace(PATH_BLOCK, "", 1), encoding="utf-8")
    return True


def remove_gitignore_entries() -> bool:
    """Undo ensure_gitignore_entries: drop the marker line and the harness entries that
    follow it, leaving every other line in place."""
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    entries = set(ownership.get("gitignore_entries", []))
    path = global_gitignore_path()
    if not path.exists():
        return False
    lines = path.read_text(encoding="utf-8").splitlines()
    if IGNORE_MARKER not in lines:
        return False
    out, i = [], 0
    while i < len(lines):
        if lines[i] == IGNORE_MARKER:
            i += 1
            while i < len(lines) and lines[i] in entries:
                i += 1
            continue
        out.append(lines[i])
        i += 1
    path.write_text("".join(ln + "\n" for ln in out), encoding="utf-8")
    return True


def ensure_local_bin_on_path(dry: bool) -> None:
    if platform.system() != "Darwin" or "zsh" not in os.environ.get("SHELL", ""):
        return
    for name in (".zprofile", ".zshrc"):
        f = home() / name
        if f.exists() and ".local/bin" in f.read_text(encoding="utf-8"):
            return
    target = home() / ".zprofile"
    say(f"  path    ~/.local/bin added to PATH in {target}")
    if not dry:
        with open(target, "a", encoding="utf-8") as fh:
            fh.write("\n" + PATH_BLOCK)


# --------------------------------------------------------------------------- commands


def cmd_sync(args: argparse.Namespace) -> int:
    if platform.system() == "Windows":
        say(UNSUPPORTED)
        return 1
    if args.dry_run:
        return _cmd_sync_unlocked(args)
    try:
        with reconcile.lock(state_dir()):
            return _cmd_sync_unlocked(args)
    except ValueError as exc:
        raise SystemExit(str(exc))


def _cmd_sync_unlocked(args: argparse.Namespace) -> int:
    if platform.system() == "Windows":
        say(UNSUPPORTED)
        return 1
    dry = args.dry_run
    session_keys = [key for key in os.environ if key.startswith(("HARNESS_STANCE_", "HARNESS_IDENTITY_"))
                    or key in ("HARNESS_PROJECT_CONFIG", "HARNESS_PERMISSIONS")]
    cfg = load_config({key: value for key, value in os.environ.items() if key not in session_keys})
    if session_keys:
        say("  scope   sync projects user defaults; project/session overrides stay in the session")
    stances = resolve_stances(cfg)
    p = posture(cfg)
    if cfg.get("codex", {}).get("manage", True):
        ctoml = codex_dir() / "config.toml"
        update_codex_config(ctoml.read_text() if ctoml.is_file() else "", cfg)
        for role in (REPO / "primitives" / "roles").glob("*.md"):
            primitive_catalog.role_projection(REPO, "codex", role,
                cfg.get("role_bindings", {}).get("codex", {}).get(role.stem, {}))
    if cfg.get("claude", {}).get("manage", True):
        read_json(claude_dir() / "settings.json")
    if cfg.get("codex", {}).get("manage", True):
        read_json(codex_dir() / "hooks.json")
    say(f"agent-harness {VERSION} · repo {REPO} · home {home()}{' · DRY RUN' if dry else ''}")
    say("stances: " + ", ".join(f"{k}={v.stem}" for k, v in stances.items()) + f" · permissions={p}")
    stale = placeholder_identity(cfg)
    if stale:
        say(f"  notice  identity {', '.join(stale)} still at the example value; the agent reads this")
        say("          as who you are. Fix with `harness init` or `harness config set identity.name \"…\"`")
    if args.dry_run and getattr(args, "print_only", False):
        return 0

    manifest = read_json(manifest_path()) or {"version": 1}
    manifest["repo"] = str(REPO)
    if not dry:
        manifest = InstallManifest(manifest)
        manifest.persist()
    report: List[str] = []
    cd = claude_dir()
    applied = read_json(applied_path()) or {}
    store = reconcile.Store(state_dir(), dry)
    if not dry:
        if cfg.get("claude", {}).get("manage", True):
            for sub in ("rules", "skills", "agents", "hooks", "output-styles", "plans"):
                (cd / sub).mkdir(parents=True, exist_ok=True)
            (cd / "rules" / "harness-stances").mkdir(exist_ok=True)
        state_dir().mkdir(parents=True, exist_ok=True)
        if not config_path().exists():
            config_path().parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(REPO / "config.example.json", config_path())
            say(f"  config  created {config_path()} from config.example.json")
            say("          run `harness init` to fill it in by answering questions")

    if cfg.get("claude", {}).get("manage", True):
        # Legacy plain files that the harness now provides.
        for name in LEGACY_RULES:
            adopt_legacy(cd / "rules" / name, manifest, dry, args.adopt, report)
        for name in HARNESS_HOOK_BASENAMES:
            adopt_legacy(cd / "hooks" / name, manifest, dry, args.adopt, report)

        # Links.
        ensure_link(cd / "rules" / "harness", REPO / "claude" / "rules", manifest, dry, args.adopt, report)
        wanted_stance_links = set()
        for name, target in stances.items():
            link = cd / "rules" / "harness-stances" / f"{name}.md"
            wanted_stance_links.add(str(link))
            ensure_link(link, target, manifest, dry, args.adopt, report)
        for old in list(manifest.get("links", [])):
            if "/rules/harness-stances/" in old["path"] and old["path"] not in wanted_stance_links:
                say(f"  unlink  {old['path']} (stance no longer selected)")
                path = Path(old["path"])
                if path.is_symlink() and os.readlink(path) != old["target"]:
                    report.append(str(path) + ": retired stance link was redirected; preserved")
                    continue
                if not dry and path.is_symlink():
                    path.unlink()
                manifest["links"].remove(old)
        for skill in sorted(p_ for p_ in (REPO / "claude" / "skills").iterdir() if p_.is_dir()):
            ensure_link(cd / "skills" / skill.name, skill, manifest, dry, args.adopt, report)
        link_dir_files(REPO / "claude" / "agents", cd / "agents", manifest, dry, args.adopt, report)
        ensure_link(cd / "hooks" / "harness", REPO / "claude" / "hooks", manifest, dry, args.adopt, report)
        for style in sorted((REPO / "claude" / "output-styles").glob("*.md")):
            ensure_link(cd / "output-styles" / style.name, style, manifest, dry, args.adopt, report)
        link_dir_files(REPO / "claude" / "commands", cd / "commands", manifest, dry, args.adopt, report)
        if cd == home() / ".claude":
            ensure_link(cd / "CLAUDE.md", REPO / "claude" / "CLAUDE.md", manifest, dry, args.adopt, report)
        else:
            native_instructions = (REPO / "primitives" / "instructions.md").read_text()
            native_instructions += "\n@" + str(cd / "CLAUDE.personal.md") + "\n"
            store.generated(cd / "CLAUDE.md", native_instructions, adopt=args.adopt)

        # Personal file.
        personal = cd / "CLAUDE.personal.md"
        existing = personal.read_text(encoding="utf-8") if personal.exists() else None
        rendered = render_personal(cfg, existing)
        if rendered != existing:
            say(f"  render  {personal}")
            if not dry:
                personal.write_text(rendered, encoding="utf-8")

        # Claude settings.
        template = runtime_template()
        settings_file = cd / "settings.json"
        live = read_json(settings_file) or {}
        mtime = settings_file.stat().st_mtime if settings_file.exists() else None
        applied = read_json(applied_path()) or {}
        merged = merge_claude_settings(live, template, cfg, retired=retired_allow_rules(applied, template))
        ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
        owned_paths = [[k] for k in ownership.get("claude", {}).get("owned_keys", [])]
        owned_paths += [["permissions", "allow"], ["permissions", "defaultMode"]]
        owned_paths += [["hooks", event] for event in template.get("hooks", {})]
        store.json(settings_file, merged, owned_paths)
        applied["claude"] = claude_projection(merged, template)
        applied["template"] = claude_projection(merge_claude_settings({}, template, cfg), template)

        # VS Code.
        if cfg.get("vscode", {}).get("manage", True):
            vs = vscode_settings_path()
            if vs.exists():
                try:
                    vlive = read_json(vs) or {}
                except SystemExit:
                    vlive = None
                    report.append(f"{vs} is not plain JSON (comments?); VS Code settings left alone")
                if vlive is not None:
                    owned = read_json(REPO / "vscode" / "settings.owned.json") or {}
                    vmerged = merge_vscode_settings(vlive, owned, cfg)
                    store.json(vs, vmerged, [[key] for key in list(owned) +
                               ["claudeCode.initialPermissionMode", "claudeCode.allowDangerouslySkipPermissions"]])
                    applied["vscode"] = {k: vmerged.get(k) for k in list(owned) + ["claudeCode.initialPermissionMode", "claudeCode.allowDangerouslySkipPermissions"]}
            else:
                say("  vscode  no user settings file found; skipping (install VS Code, then re-run sync)")

    # Codex consumes the same policy text, skills and role contracts.
    if cfg.get("codex", {}).get("manage", True):
        personal_codex = codex_dir() / "AGENTS.personal.md"
        ptext = personal_codex.read_text() if personal_codex.exists() else None
        identity = render_personal(cfg, None)
        text = render_codex_agents(stances, identity + ("\n" + ptext if ptext else ""))
        agents = codex_dir() / "AGENTS.md"
        legacy = agents.is_file() and agents.read_text().startswith(CODEX_BANNER)
        previous = store.data["files"].get(str(agents), {}).get("prior")
        if previous and not previous.startswith(CODEX_BANNER):
            text += "\n---\n<!-- Adopted personal guidance -->\n" + previous
        elif agents.is_file() and not legacy and args.adopt_codex and str(agents) not in store.data["files"]:
            text += "\n---\n<!-- Adopted personal guidance -->\n" + agents.read_text()
        store.generated(agents, text, adopt=args.adopt_codex or legacy)
        wanted = reconcile.tomlkit.parse(update_codex_config("", cfg)).unwrap()
        store.toml(codex_dir() / "config.toml", wanted)
        hook_file = codex_dir() / "hooks.json"
        hook_live = read_json(hook_file) or {}
        hook_template = lifecycle.registration(REPO, "codex")
        hook_merged = deepcopy(hook_live)
        hook_merged.setdefault("hooks", {})
        for event, entries in hook_template["hooks"].items():
            hook_merged["hooks"][event] = [e for e in hook_live.get("hooks", {}).get(event, [])
                                          if not _is_harness_entry(e)] + entries
        store.json(hook_file, hook_merged, [["hooks", event] for event in hook_template["hooks"]])
        say("  codex   hooks registered; native hook trust must be accepted in the client")
        skills_home = home() / ".agents" / "skills"
        for skill in sorted((REPO / "primitives" / "skills").iterdir()):
            if skill.is_dir():
                ensure_link(skills_home / skill.name, skill, manifest, dry, args.adopt, report)
        for role in sorted((REPO / "primitives" / "roles").glob("*.md")):
            binding = cfg.get("role_bindings", {}).get("codex", {}).get(role.stem, {})
            store.generated(codex_dir() / "agents" / (role.stem + ".toml"),
                            primitive_catalog.role_projection(REPO, "codex", role, binding), adopt=args.adopt)
        for workflow in sorted((REPO / "primitives" / "workflows").glob("*.md")):
            fields, body = primitive_catalog.frontmatter(workflow)
            content = "---\nname: harness-" + workflow.stem + "\ndescription: " + fields["description"] + "\n---\n\n"
            content += body.replace("{{arguments}}", "the arguments supplied with this invocation")
            store.generated(skills_home / ("harness-" + workflow.stem) / "SKILL.md", content, adopt=args.adopt)
    report.extend(store.conflicts)

    ensure_gitignore_entries(dry)
    ensure_local_bin_on_path(dry)
    # The harness checkout lints every commit before it is made.
    if (REPO / ".githooks" / "pre-commit").exists() and not dry:
        subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath", ".githooks"], capture_output=True)

    manifest["synced_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    manifest["config"] = {"stances": cfg["stances"], "permissions": p}
    if not dry:
        write_json_atomic(manifest_path(), manifest)
        write_json_atomic(applied_path(), applied)
    if report:
        say("\nNeeds your attention:")
        for r in report:
            say("  - " + r)
        return 2
    say("sync complete")
    return 0


def runtime_template():
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    template["hooks"] = lifecycle.registration(REPO, "claude-code")["hooks"]
    return template


def _diff_lines() -> List[str]:
    lines: List[str] = []
    manifest = read_json(manifest_path())
    if not manifest:
        return ["harness not synced yet (no manifest); run `harness sync`"]
    for link in manifest.get("links", []):
        p = Path(link["path"])
        if not p.is_symlink():
            lines.append(f"missing link {p}")
        elif Path(os.readlink(p)) != Path(link["target"]):
            lines.append(f"redirected link {p} -> {os.readlink(p)}")
        elif not p.exists():
            lines.append(f"broken link {p}")
    cfg = load_config({key: value for key, value in os.environ.items()
                       if not key.startswith(("HARNESS_STANCE_", "HARNESS_IDENTITY_"))
                       and key not in ("HARNESS_PROJECT_CONFIG", "HARNESS_PERMISSIONS")})
    template = runtime_template()
    applied = read_json(applied_path()) or {}
    live = read_json(claude_dir() / "settings.json") or {}
    live_p = claude_projection(live, template)
    applied_p = applied.get("claude", {})
    template_p = claude_projection(merge_claude_settings({}, template, cfg), template)
    if applied_p:
        for k, v in live_p["keys"].items():
            if applied_p.get("keys", {}).get(k) != v:
                lines.append(f"live-only change: settings.{k} = {v!r} (upstream it or re-sync)")
        for rule in live_p["allow"]:
            if rule not in applied_p.get("allow", []) and rule not in template_p["allow"]:
                lines.append(f"live-only allow rule: {rule} (upstream?)")
        for rule in template_p["allow"]:
            if rule not in live_p["allow"]:
                lines.append(f"pending sync: allow rule {rule}")
        for hid in template_p["hooks"]:
            if hid not in live_p["hooks"]:
                lines.append(f"pending sync: hook {hid}")
        if applied.get("template") and applied["template"] != template_p:
            lines.append("pending sync: settings template changed since last sync")
    stances_now = dict(cfg["stances"])
    if manifest.get("config", {}).get("stances") and manifest["config"]["stances"] != stances_now:
        lines.append("pending sync: stance selection changed since last sync")
    lines.extend(reconcile.Store(state_dir(), dry=True).drift())
    return lines


def _checkout_state() -> str:
    try:
        ref = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, timeout=5).stdout.strip()
        dirty = subprocess.run(["git", "-C", str(REPO), "status", "--porcelain"], capture_output=True, text=True, timeout=5).stdout.strip()
        ahead = subprocess.run(["git", "-C", str(REPO), "rev-list", "--count", "@{upstream}..HEAD"], capture_output=True, text=True, timeout=5).stdout.strip()
        parts = [ref or "?"]
        if dirty:
            parts.append(f"{len(dirty.splitlines())} uncommitted file(s)")
        if ahead and ahead != "0":
            parts.append(f"{ahead} unpushed commit(s)")
        return " · ".join(parts)
    except Exception:
        return "unknown"


def cmd_diff(args: argparse.Namespace) -> int:
    lines = _diff_lines()
    if not lines:
        if not args.quiet:
            say("no drift")
        return 0
    if args.quiet:
        say(f"{len(lines)} item(s): " + "; ".join(lines[:3]) + (" …" if len(lines) > 3 else ""))
    else:
        for l in lines:
            say("- " + l)
    return 1


def _version_of(cmd: List[str]) -> str:
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return (out.stdout or out.stderr).strip().splitlines()[0] if (out.stdout or out.stderr).strip() else "installed"
    except FileNotFoundError:
        return "not installed"
    except Exception as exc:
        return f"error: {exc}"


def hook_commands(settings: Dict[str, Any]) -> List[str]:
    out: List[str] = []
    for entries in (settings.get("hooks") or {}).values():
        for entry in entries if isinstance(entries, list) else []:
            for hook in (entry.get("hooks") or []) if isinstance(entry, dict) else []:
                command = hook.get("command") if isinstance(hook, dict) else None
                if isinstance(command, str) and command.strip():
                    out.append(command)
    return out


def hook_health(settings: Dict[str, Any]) -> Tuple[int, List[str]]:
    """How many hook commands are registered, and what stops them running.

    Claude Code treats a hook that fails to start as non-blocking, so a missing interpreter or an
    unsynced script path turns every hook into a silent no-op. Two of them are guards — the
    command grader that asks before something irreversible, and the stop gate that runs the
    repository's own checks — so the failure mode is the guards disappearing with nothing said.
    """
    commands = hook_commands(settings)
    problems: List[str] = []
    interpreters: Dict[str, bool] = {}
    for command in commands:
        try:
            parts = shlex.split(command)
        except ValueError:
            continue
        if not parts:
            continue
        name = parts[0]
        if name not in interpreters:
            interpreters[name] = _tool(name) is not None or Path(name).is_file()
        for arg in parts[1:]:
            if not arg.endswith(".py"):
                continue
            script = Path(os.path.expanduser(arg))
            note = f"script not found: {arg}"
            if not script.exists() and note not in problems:
                problems.append(note)
    for name, found in interpreters.items():
        if not found:
            problems.append(f"interpreter not found: {name}")
    return len(commands), problems


def cmd_doctor(args: argparse.Namespace) -> int:
    say(f"agent-harness {VERSION}")
    say(f"  repo: {REPO}")
    say(f"  checkout: {_checkout_state()}")
    for name, cmd in (("claude", ["claude", "--version"]), ("code", ["code", "--version"]), ("codex", ["codex", "--version"]), ("gh", ["gh", "--version"]), ("python3", [sys.executable, "--version"])):
        say(f"  {name}: {_version_of(cmd)}")
    say(f"  gh login: {_version_of(['gh', 'auth', 'status'])}")
    say(f"  claude credentials present (not proof of login): {(claude_dir() / '.credentials.json').exists() or (home() / '.claude.json').exists()}")
    say(f"  codex credentials present (not proof of login): {(codex_dir() / 'auth.json').exists()}")
    cfg = load_config()
    for runtime, path in (("claude", claude_dir() / "settings.json"),
                          ("codex", codex_dir() / "hooks.json")):
        if not cfg.get(runtime, {}).get("manage", True):
            say(f"  {runtime} hooks: unmanaged")
            continue
        try:
            count, problems = hook_health(read_json(path) or {})
        except (SystemExit, OSError) as exc:
            say(f"  {runtime} hooks: unreadable configuration: {exc}")
            continue
        if not count:
            say(f"  {runtime} hooks: none registered in {path.name}; run `harness sync`")
        elif problems:
            say(f"  {runtime} hooks: {count} registered, {len(problems)} problem(s); affected hooks cannot run:")
            for problem in problems:
                say(f"    {problem}")
            say("    Hook startup failures can fail silently; command grading and the stop gate may be unavailable.")
        else:
            say(f"  {runtime} hooks: {count} registered, script paths exist; native trust and activation unverified")
    stale = placeholder_identity(load_config())
    say("  identity: " + (f"{', '.join(stale)} still at the example value, run `harness init`"
                          if stale else "set"))
    lines = _diff_lines()
    say("  drift: " + ("none" if not lines else f"{len(lines)} item(s), run `harness diff`"))
    if shutil.which("claude"):
        say("  claude doctor:")
        try:
            out = subprocess.run(["claude", "doctor"], capture_output=True, text=True, timeout=60)
            for l in (out.stdout or out.stderr).strip().splitlines()[:20]:
                say("    " + l)
        except Exception as exc:
            say(f"    could not run: {exc}")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    try:
        with reconcile.lock(state_dir()):
            return _cmd_uninstall_unlocked(args)
    except ValueError as exc:
        raise SystemExit(str(exc))


def _cmd_uninstall_unlocked(args: argparse.Namespace) -> int:
    manifest = read_json(manifest_path()) or {}
    if not manifest and not (state_dir() / "ownership.json").exists():
        say("nothing to uninstall (no manifest)")
        return 0
    conflicts = []
    for link in manifest.get("links", []):
        p = Path(link["path"])
        if p.is_symlink() and os.readlink(p) in (link["target"], link.get("pending_from")):
            p.unlink()
            say(f"  unlink  {p}")
        elif p.exists() or p.is_symlink():
            conflicts.append(str(p) + ": changed link or replacement preserved")
    for item in manifest.get("adopted", []):
        src, dst = Path(item["moved_to"]), Path(item["path"])
        if src.exists() or src.is_symlink():
            if dst.exists() or dst.is_symlink():
                conflicts.append(str(dst) + ": adopted backup retained; destination is occupied")
            else:
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(src), str(dst))
                say(f"  restore {dst}")
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    sf = claude_dir() / "settings.json"
    live = read_json(sf)
    if live is not None and str(sf) not in reconcile.Store(state_dir()).data["files"]:
        write_json_atomic(sf, strip_claude_settings(live, template), backup=True)
        say(f"  strip   {sf}")
    store = reconcile.Store(state_dir())
    store.uninstall()
    store.conflicts.extend(conflicts)
    for conflict in store.conflicts:
        say("  conflict " + conflict)
    if remove_gitignore_entries():
        say(f"  restore {global_gitignore_path()}")
    if remove_local_bin_from_path():
        say(f"  restore {home() / '.zprofile'}")
    if not store.conflicts:
        for f in (manifest_path(), applied_path()):
            if f.exists():
                f.unlink()
    say("uninstalled; personal files, config and the checkout are untouched")
    return 2 if store.conflicts else 0


def lint_files(root: Path, files: List[Path], terms: Optional[Tuple[List[str], List[str]]] = None) -> List[str]:
    """Lint the given files (paths under root). No file is exempt, including this one."""
    hits: List[str] = []
    everywhere, docs_ok = terms if terms is not None else load_lint_terms()
    names = [re.compile(r"(?i)\b" + re.escape(t) + r"\b") for t in maintainer_terms(root)]
    docs_only = [re.compile(r"(?i)\b" + re.escape(t) + r"\b") for t in docs_ok]
    shapes = [(label, re.compile(p)) for label, p in SHAPE_PATTERNS]
    secrets = [re.compile(p) for p in SECRET_PATTERNS]
    if not secrets:
        # An empty list would pass every file silently; say so instead, on every lint path.
        hits.append("secrets: pattern list unavailable, claude/hooks/rule-detectors.py did not import")
    for path in files:
        if not path.is_file() or path.is_symlink():
            continue
        rel = path.relative_to(root)
        if any(part in LINT_SKIP_DIRS for part in rel.parts):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        installed = rel.parts[0] in NAME_FORBIDDEN_DIRS or rel.name in NAME_FORBIDDEN_FILES
        for n, line in enumerate(text.splitlines(), 1):
            low = line.lower()
            for term in everywhere:
                if term in low:
                    hits.append(f"{rel}:{n}: personal term from lint-terms file")
            if rel.parts[0] != "docs":
                for rx in docs_only:
                    if rx.search(line):
                        hits.append(f"{rel}:{n}: project name allowed only under docs/")
            if installed:
                for rx in names:
                    if rx.search(line):
                        hits.append(f"{rel}:{n}: maintainer name in installed content")
            for label, rx in shapes:
                if rx.search(line):
                    hits.append(f"{rel}:{n}: {label}")
            for rx in secrets:
                if rx.search(line):
                    hits.append(f"{rel}:{n}: secret pattern {rx.pattern}")
    return hits


def check_detectors(root: Path) -> List[str]:
    """Fail when a rule file has neither a detector nor an explicit opt-out.

    A rule nobody can measure is a rule nobody can prune; `harness usage --rules` reports
    the hits, and this check is what keeps the registry honest as rules are added.
    """
    rules = sorted(p.stem for p in (root / "claude" / "rules").glob("*.md"))
    if not rules:
        return []
    module = load_detectors(root)
    if module is None:
        return ["detectors: claude/hooks/rule-detectors.py is missing or does not import"]
    measured = {d.rule for d in module.DETECTORS.values()}
    hits = []
    for stem in rules:
        if stem in measured or stem in module.OPT_OUT:
            continue
        hits.append(f"detectors: claude/rules/{stem}.md has no detector and no OPT_OUT entry")
    if hits:
        hits.append("detectors: add a Detector with rule=\"<stem>\" to DETECTORS, or an OPT_OUT "
                    "entry giving the one-line reason nothing in a transcript can decide it")
    return hits


def lint_tree(root: Path, terms: Optional[Tuple[List[str], List[str]]] = None) -> List[str]:
    """Lint everything git would commit: tracked files plus untracked files that are not ignored.
    Outside a git repository, every file."""
    try:
        out = subprocess.run(["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode == 0:
            files = sorted(root / f for f in out.stdout.split("\0") if f)
            return lint_files(root, files, terms) + check_detectors(root)
    except Exception:
        pass
    return lint_files(root, sorted(p for p in root.rglob("*") if p.is_file()), terms) + check_detectors(root)


def _line_count(path: Path) -> int:
    return len(path.read_text(encoding="utf-8").splitlines())


def always_loaded_lines(root: Path) -> Tuple[int, List[Tuple[str, int]]]:
    """Line counts of everything loaded on every turn, as (total, [(group, lines)]).

    The stance total is the worst case — the longest variant of each dimension — so the cap holds
    for every selection a user could make, not only the default one.
    """
    groups: List[Tuple[str, int]] = []
    claude_md = root / "claude" / "CLAUDE.md"
    if claude_md.is_file():
        groups.append(("claude/CLAUDE.md", _line_count(claude_md)))
    rules = sorted((root / "claude" / "rules").glob("*.md"))
    if rules:
        plural = "file" if len(rules) == 1 else "files"
        groups.append((f"claude/rules/ ({len(rules)} {plural})", sum(_line_count(p) for p in rules)))
    stances = root / "claude" / "stances"
    if stances.is_dir():
        for d in sorted(p for p in stances.iterdir() if p.is_dir()):
            variants = sorted(d.glob("*.md"))
            if not variants:
                continue
            worst = max(variants, key=lambda p: (_line_count(p), p.name))
            groups.append((f"claude/stances/{d.name}/ (longest: {worst.name})", _line_count(worst)))
    return sum(n for _, n in groups), groups


def check_context_cap(root: Path) -> List[str]:
    """Fail when always-loaded context exceeds the cap, printing the breakdown."""
    total, groups = always_loaded_lines(root)
    if not groups or total <= ALWAYS_LOADED_CAP:
        return []
    hits = [f"context-cap: always-loaded context is {total} lines, over the {ALWAYS_LOADED_CAP}-line cap"]
    for name, n in sorted(groups, key=lambda g: (-g[1], g[0])):
        hits.append(f"context-cap:   {n:4d}  {name}")
    hits.append("context-cap: keep the operative lines in the rule and move the rest into the skill it "
                "points at (see the harness-authoring skill)")
    return hits


def lint_staged(root: Path) -> List[str]:
    out = subprocess.run(["git", "-C", str(root), "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                         capture_output=True, text=True, timeout=10)
    files = [root / f for f in out.stdout.split() if (root / f).is_file()]
    return lint_files(root, files)


def cmd_lint(args: argparse.Namespace) -> int:
    root = Path(args.path).resolve() if args.path else REPO
    if getattr(args, "staged", False):
        hits = lint_staged(root)
        scope = "staged files"
    else:
        hits = lint_tree(root)
        scope = str(root)
    hits = hits + check_context_cap(root)
    if (root / "primitives" / "roles").is_dir():
        hits += ["projection drift: " + name + "; run `harness generate`"
                 for name in primitive_catalog.projection_drift(root)]
    for h in hits:
        say(h)
    everywhere, _ = load_lint_terms()
    note = "" if everywhere else " (no personal lint-terms file; shapes and secrets only)"
    say(f"lint: {len(hits)} finding(s) in {scope}{note}")
    return 1 if hits else 0


def cmd_catalog(args: argparse.Namespace) -> int:
    print(json.dumps(primitive_catalog.catalog(REPO), indent=2))
    return 0


def cmd_generate(args: argparse.Namespace) -> int:
    changed = primitive_catalog.projection_drift(REPO)
    if args.check:
        for name in changed:
            say("projection drift: " + name)
        return 1 if changed else 0
    for name, content in primitive_catalog.projections(REPO).items():
        if name in changed:
            (REPO / name).write_text(content, encoding="utf-8")
            say("generated " + name)
    return 0


def cmd_stances(args: argparse.Namespace) -> int:
    cfg = load_config()
    choices = resolve_stances(cfg)
    data = {"schema_version": 1, "precedence": ["defaults", "user", "project", "session"],
            "stances": {name: {"variant": path.stem, "source": str(path),
                                "behavior": path.read_text(encoding="utf-8").strip()}
                        for name, path in choices.items()}}
    data["adapter_coverage"] = compatibility.coverage(REPO, choices)
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        for name, choice in data["stances"].items():
            say(name + "=" + choice["variant"] + "\n" + choice["behavior"] + "\n")
        say("Native runtime restrictions still apply; stance guidance is not proof of enforcement.")
    return 0


def cmd_workspace(args: argparse.Namespace) -> int:
    if args.action != "create":
        raise SystemExit("workspace: only `create` is supported")
    name = args.name
    folders = [str(Path(f).expanduser().resolve()) for f in args.folders]
    if not folders:
        raise SystemExit("workspace create needs at least one folder; the first is the root")
    if not args.no_harness and str(REPO) not in folders:
        folders.append(str(REPO))
    out = Path.cwd() / f"{name}.code-workspace"
    if out.exists() and not args.force:
        raise SystemExit(f"{out} exists; pass --force to overwrite")
    template = (REPO / "vscode" / "workspace.template.code-workspace").read_text(encoding="utf-8")
    body = template.replace("__FOLDERS__", json.dumps([{"path": f} for f in folders], indent=2))
    out.write_text(body, encoding="utf-8")
    say(f"wrote {out}")
    # Session store keyed off the first folder; one store, symlinked from every possible root key.
    projects = claude_dir() / "projects"
    stores = claude_dir() / "workspaces"
    store = stores / name
    store.mkdir(parents=True, exist_ok=True)
    (store / "memory").mkdir(exist_ok=True)
    projects.mkdir(parents=True, exist_ok=True)
    for f in folders:
        key = projects / f.replace("/", "-")
        if key.is_symlink():
            continue
        if key.exists():
            say(f"  {key} already holds history; leaving it alone (see docs/workspaces.md to merge it)")
            continue
        os.symlink(os.path.relpath(store, projects), key)
        say(f"  session key {key.name} -> workspaces/{name}")
    say(f"open with: code {out}")
    return 0


# --------------------------------------------------------------------------- worktrees


WORKTREE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def worktree_root() -> Path:
    """The dedicated root for disposable task checkouts."""
    configured = os.environ.get("HARNESS_WORKTREE_ROOT")
    return Path(configured).expanduser().resolve() if configured else (home() / "worktrees").resolve()


def git_root(start: str) -> Path:
    probe = subprocess.run(
        ["git", "-C", str(Path(start).expanduser()), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True, timeout=10,
    )
    if probe.returncode != 0:
        raise SystemExit(probe.stderr.strip() or f"{start} is not inside a git repository")
    common = Path(probe.stdout.strip()).resolve()
    if common.name != ".git":
        raise SystemExit(f"unsupported bare repository: {start}")
    return common.parent


def worktree_destination(repo: Path, name: str) -> Path:
    if not WORKTREE_NAME.fullmatch(name):
        raise SystemExit("worktree name must use only letters, numbers, dots, underscores, and hyphens")
    return worktree_root() / repo.name / name


def ensure_worktree_bucket(repo: Path) -> Path:
    bucket = worktree_root() / repo.name
    marker = bucket / ".harness-repository"
    identity = str((repo / ".git").resolve())
    if marker.exists() and marker.read_text(encoding="utf-8").strip() != identity:
        raise SystemExit(f"{bucket} belongs to a different repository; set HARNESS_WORKTREE_ROOT")
    if not marker.exists() and bucket.exists() and any(bucket.iterdir()):
        raise SystemExit(f"refusing to claim non-empty worktree bucket without a repository marker: {bucket}")
    bucket.mkdir(parents=True, exist_ok=True)
    if not marker.exists():
        marker.write_text(identity + "\n", encoding="utf-8")
    return bucket


def _git(repo: Path, *args: str, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo), *args], check=False, capture_output=capture,
        text=True, timeout=120,
    )


def _registered_worktrees(repo: Path) -> List[Dict[str, str]]:
    out = _git(repo, "worktree", "list", "--porcelain", capture=True)
    if out.returncode != 0:
        raise SystemExit(out.stderr.strip() or "git worktree list failed")
    records: List[Dict[str, str]] = []
    current: Dict[str, str] = {}
    for line in out.stdout.splitlines() + [""]:
        if not line:
            if current:
                records.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value
    return records


def cmd_worktree(args: argparse.Namespace) -> int:
    repo = git_root(args.repo or ".")
    if args.action == "create":
        dest = worktree_destination(repo, args.name)
        if dest.exists():
            raise SystemExit(f"{dest} already exists")
        if not args.no_fetch:
            fetched = _git(repo, "fetch", "origin")
            if fetched.returncode != 0:
                return fetched.returncode
        ensure_worktree_bucket(repo)
        branch = args.branch or args.name
        created = _git(repo, "worktree", "add", "-b", branch, str(dest), args.base, capture=True)
        if created.returncode == 0:
            say(str(dest))
        elif created.stderr:
            say(created.stderr.strip())
        return created.returncode

    if args.action == "remove":
        dest = worktree_destination(repo, args.name)
        registered = {Path(r["worktree"]).resolve() for r in _registered_worktrees(repo)}
        if dest not in registered:
            say(f"not a registered worktree: {dest}")
            return 1
        status = _git(dest, "status", "--porcelain", "--ignored", "--untracked-files=all", capture=True)
        if status.returncode != 0:
            return status.returncode
        if status.stdout.strip():
            say(f"refusing to remove worktree with modified, untracked, or ignored files: {dest}")
            return 1
        symbolic = _git(dest, "symbolic-ref", "--quiet", "HEAD", capture=True)
        if symbolic.returncode != 0:
            head = _git(dest, "rev-parse", "HEAD", capture=True)
            refs = _git(repo, "for-each-ref", "--contains", head.stdout.strip(), "--format=%(refname)", capture=True)
            if head.returncode != 0 or refs.returncode != 0 or not refs.stdout.strip():
                say(f"refusing to remove detached worktree whose HEAD is not contained by a ref: {dest}")
                return 1
        return _git(repo, "worktree", "remove", str(dest)).returncode

    dirty = 0
    for record in _registered_worktrees(repo):
        path = Path(record["worktree"])
        if "prunable" in record:
            say(f"prunable\t{path}")
            continue
        status = _git(path, "status", "--porcelain", "--ignored", "--untracked-files=all", capture=True)
        if status.returncode != 0:
            say(f"unknown\t{path}")
            dirty += 1
            continue
        state = "dirty" if status.stdout.strip() else "clean"
        dirty += state == "dirty"
        branch = record.get("branch", "detached").removeprefix("refs/heads/")
        say(f"{state}\t{branch}\t{path}")
    return 1 if dirty else 0


def _tool(name: str) -> Optional[str]:
    """Absolute path to an executable, or None if it cannot be found.

    Searches PATH, then the bin directories of the keg-only Homebrew formulae this installer
    asks for. A keg-only formula is deliberately not linked into the Homebrew prefix, so
    `brew install node@22` leaves `npm` off PATH on a machine that has no other node.
    """
    found = shutil.which(name)
    if found:
        return found
    for opt in KEG_ONLY_BINS:
        candidate = Path(opt) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def _run(cmd: List[str], dry: bool) -> bool:
    """Run a command. A missing executable is reported and skipped, never raised.

    `subprocess.run` raises FileNotFoundError when argv[0] does not exist, and `check=False`
    suppresses a non-zero exit, not a missing binary. An installer that ends in a traceback
    tells the person running it nothing, so every external call goes through here.
    """
    if cmd[0].startswith("/"):
        exe = cmd[0] if Path(cmd[0]).exists() else None  # /bin/bash is absent on some platforms
    else:
        exe = _tool(cmd[0])
    if exe is None:
        say(f"  skip    {cmd[0]} is not installed; skipped `{' '.join(cmd)}`")
        return False
    say("  $ " + " ".join(cmd))
    if not dry:
        subprocess.run([exe] + cmd[1:], check=False)
    return True


def _gh_login_line() -> str:
    if _tool("gh") is None:
        return "not installed; needed only to open pull requests"
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0:
        return "run `gh auth login`"
    return "logged in"


UNSUPPORTED = ("Native Windows is not supported: runtime projections use symlinks and POSIX hooks.\n"
               "WSL2 is a separate, currently unqualified target; see the compatibility catalog.")


def cmd_install(args: argparse.Namespace) -> int:
    if platform.system() == "Windows":
        say(UNSUPPORTED)
        return 1
    dry = args.dry_run
    cfg = load_config()
    mac = platform.system() == "Darwin"
    say(f"agent-harness install{' (dry run)' if dry else ''}")
    if mac and not args.no_brew:
        if not shutil.which("xcode-select") or subprocess.run(["xcode-select", "-p"], capture_output=True).returncode != 0:
            say("  Xcode Command Line Tools missing: run `xcode-select --install`, then re-run")
            return 1
        if not shutil.which("brew"):
            _run(["/bin/bash", "-c", 'curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | bash'], dry)
        _run(["brew", "install"] + BREW_PACKAGES, dry)
    if mac and not args.no_apps and not args.no_vscode:
        if not shutil.which("code"):
            _run(["brew", "install", "--cask", "visual-studio-code"], dry)
        for f in ["extensions.txt"] + (["extensions.optional.txt"] if args.with_optional else []):
            for ext in (REPO / "vscode" / f).read_text().split():
                _run(["code", "--install-extension", ext, "--force"], dry)
    if not args.no_apps:
        if cfg.get("claude", {}).get("manage", True) and not shutil.which("claude"):
            _run(["/bin/bash", "-c", "curl -fsSL https://claude.ai/install.sh | bash"], dry)
        if cfg.get("codex", {}).get("manage", True) and not args.no_codex and not shutil.which("codex"):
            _run(["npm", "install", "-g", "@openai/codex"], dry)
    sync_args = argparse.Namespace(dry_run=dry, adopt=args.adopt, adopt_codex=args.adopt_codex, print_only=False)
    rc = cmd_sync(sync_args)
    say("\nLogins (interactive, cannot be automated):")
    if cfg.get("claude", {}).get("manage", True):
        say("  claude   — run `claude` and complete the browser login")
    if cfg.get("codex", {}).get("manage", True):
        say("  codex    — run `codex login`")
    say("  gh       — " + _gh_login_line())
    return rc


def cmd_config(args: argparse.Namespace) -> int:
    if args.action == "set":
        return config_set(args.key, args.value)
    cfg = load_config()
    node: Any = cfg
    for part in args.key.split("."):
        if not isinstance(node, dict) or part not in node:
            raise SystemExit(f"no such key: {args.key}")
        node = node[part]
    say(node if isinstance(node, str) else json.dumps(node))
    return 0


BOOL_KEYS = ["vscode.manage", "claude.manage", "codex.manage", "permissions_bypass_acknowledged"]


def coerce_config_value(key: str, value: str) -> Any:
    """Validate one dotted key against what sync will accept, before it reaches the file.

    A config that only fails at the next sync is worse than one that fails at the keystroke
    that broke it, because the sync is where the message is least expected.
    """
    if key in BOOL_KEYS:
        if value.lower() not in ("true", "false"):
            raise SystemExit(f"{key} is true or false; got '{value}'")
        return value.lower() == "true"
    head, _, tail = key.partition(".")
    if head == "identity":
        if tail not in IDENTITY_KEYS:
            raise SystemExit(f"identity has no field '{tail}'; fields: {', '.join(IDENTITY_KEYS)}")
        if tail == "expertise" and value not in GUIDANCE:
            raise SystemExit(f"identity.expertise is {' or '.join(sorted(GUIDANCE))}; got '{value}'")
        return value
    if head == "stances":
        cfg = load_config(env={})
        cfg["stances"][tail] = value
        resolve_stances(cfg)
        return value
    if key == "primitive_roots":
        roots = json.loads(value)
        if not isinstance(roots, list) or not all(isinstance(item, str) and Path(item).expanduser().is_absolute() for item in roots):
            raise SystemExit("primitive_roots must be a JSON array of absolute directory paths")
        cfg = load_config(env={})
        cfg["primitive_roots"] = roots
        resolve_stances(cfg)
        return roots
    if key == "permissions":
        if value != "inherit" and value not in POSTURES:
            raise SystemExit(f"permissions must be inherit, bypass, auto or manual; got '{value}'")
        return value
    raise SystemExit(f"{key} is not a key this command sets; try identity.NAME, stances.NAME, "
                     f"permissions, or one of {', '.join(BOOL_KEYS)}")


def config_set(key: str, value: Optional[str]) -> int:
    if value is None:
        raise SystemExit(f"config set needs a value: harness config set {key} VALUE")
    coerced = coerce_config_value(key, value)
    path = config_path()
    cfg = read_json(path)
    if cfg is None:
        cfg = deepcopy(example_config())
    head, _, tail = key.partition(".")
    if tail:
        cfg.setdefault(head, {})[tail] = coerced
    else:
        cfg[head] = coerced
    write_json_atomic(path, cfg)
    say(f"{key} = {json.dumps(coerced)}  ({path})")
    say("run `harness sync` to apply it")
    return 0


def _ask(prompt: str, default: str, choices: Optional[List[str]] = None, required: bool = False) -> str:
    if choices:
        print(f"  {prompt}: {' · '.join(choices)}")
    label = "  " if choices else f"  {prompt}"
    hint = f" [{default}]" if default else ""
    while True:
        try:
            raw = input(f"{label}{hint}: ").strip()
        except EOFError:
            raw = ""
        value = raw or default
        if required and not value:
            print("    this one is needed")
            continue
        if choices and value not in choices:
            print(f"    not one of: {', '.join(choices)}")
            continue
        return value


def _detect_timezone() -> str:
    link = Path("/etc/localtime")
    if link.is_symlink():
        head, sep, name = str(link.resolve()).partition("/zoneinfo/")
        if sep and name:
            return name
    return "UTC"


def _detect_github() -> str:
    if _tool("gh") is None:
        return ""
    out = subprocess.run(["gh", "api", "user", "-q", ".login"], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def cmd_init(args: argparse.Namespace) -> int:
    """Write the config file by asking, so a first run needs no hand-edited JSON."""
    path = config_path()
    if path.exists() and not args.force:
        say(f"{path} already exists.")
        say("  one value:  harness config set identity.name \"…\"")
        say("  start over: harness init --force")
        return 1
    if not sys.stdin.isatty():
        say("harness init asks questions and needs a terminal.")
        say("Without one, write the same values with `harness config set KEY VALUE`.")
        return 1
    example = example_config()
    cfg = deepcopy(example)
    print(f"agent-harness {VERSION} — setup. Enter keeps the value in brackets.\n")
    print("Identity. This is rendered into ~/.claude/CLAUDE.personal.md, which stays on this")
    print("machine; nothing here is ever written into the checkout.\n")
    identity = cfg.setdefault("identity", {})
    identity["name"] = _ask("Your name", "", required=True)
    identity["pronouns"] = _ask("Pronouns", example.get("identity", {}).get("pronouns", "they/them"))
    identity["role"] = _ask("One line on what you do, so answers are pitched right", "", required=True)
    identity["github"] = _ask("GitHub handle, blank if you have none", _detect_github())
    identity["timezone"] = _ask("Timezone", _detect_timezone())
    print("\nHow much should answers explain themselves?")
    print("  expert   — skips fundamentals and assumes you know the tools")
    print("  beginner — says what each step and command does, and defines terms")
    identity["expertise"] = _ask("How much to explain", "expert", sorted(GUIDANCE))
    print("\nWhat will you mostly use this for?")
    print("  software — shipping code: tests required, Conventional Commits, one-screen plans")
    print("  general  — everything else: no commit ceremony, no test gate, lighter plans")
    preset = _ask("Mostly", "software", sorted(STANCE_PRESETS))
    defaults = dict(example.get("stances", {}), **STANCE_PRESETS[preset])
    print("\nPreferences. Every one has a default; Enter takes it.")
    print("They are described in docs/preferences.md and can be changed later.\n")
    stances = cfg.setdefault("stances", {})
    for name in STANCE_NAMES:
        variants = stance_variants(name)
        stances[name] = _ask(name, defaults.get(name, variants[0]), variants)
    write_json_atomic(path, cfg)
    print(f"\nwrote {path}")
    print("next: bin/harness sync")
    return 0


def cmd_trust(args: argparse.Namespace) -> int:
    """Record (or with --remove, forget) a repository root the stop-gate hook may run a gate in."""
    start = Path(args.path).expanduser() if args.path else Path.cwd()
    probe = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True)
    root = Path(probe.stdout.strip()) if probe.returncode == 0 and probe.stdout.strip() else start.resolve()
    path = trusted_path()
    lines = [ln.strip() for ln in path.read_text(encoding="utf-8").splitlines()] if path.exists() else []
    roots = [ln for ln in lines if ln and not ln.startswith("#")]
    if args.remove:
        roots = [r for r in roots if Path(r) != root]
    elif str(root) not in roots:
        roots.append(str(root))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(r + "\n" for r in roots), encoding="utf-8")
    say(("forgot " if args.remove else "trusted ") + str(root))
    say(f"  {path}: {len(roots)} root(s)")
    return 0


# A rule that trips in more than this share of sessions is prose the agent keeps walking past,
# and wants to be a hook; one with no hit at all over a full window can leave the 200 lines.
# Both need a window wide enough for the share to mean anything.
RULE_PROMOTE_SHARE = 0.30
RULE_MIN_SESSIONS = 20


def rule_ids(rows: List[Dict[str, Any]]) -> List[str]:
    """Every detector id to report on: the registry's, so a rule with no hit is still a line,
    plus any id a record carries that the registry no longer defines."""
    module = load_detectors()
    ids = set(getattr(module, "DETECTORS", {}) or {})
    for row in rows:
        ids.update(k for k in (row.get("rules") or {}) if isinstance(k, str))
    return sorted(ids)


def rule_report(rows: List[Dict[str, Any]], by: str, days: int) -> int:
    """`usage --rules`: hits per detector, or per repo or stance variant.

    Only a record that carries a `rules` map is evidence. One written before the detectors
    existed, or one whose registry would not import, is absent from every count and from the
    denominator: counting it as a session with no hit would turn a gap into a clean bill.
    """
    measured = [r for r in rows if isinstance(r.get("rules"), dict) and not r.get("rules_errors")]
    legacy = sum(1 for r in rows if not isinstance(r.get("rules"), dict) and not r.get("rules_error"))
    errored = sum(1 for r in rows if r.get("rules_error") or r.get("rules_errors"))
    if legacy or errored:
        say(f"{legacy + errored} session(s) in the window carry no rule data "
            f"({legacy} recorded before detectors, {errored} rules_error); run --rescan to backfill")
    if not measured:
        say(f"no measured sessions in the last {days} day(s)")
        return 0

    if by == "rule":
        total = len(measured)
        head = f"{'detector':<38}{'hits':>7}{'sessions':>10}{'of':>6}{'share':>8}  note"
        say(head)
        say("-" * len(head))
        for did in rule_ids(measured):
            hits = sum(int(r["rules"].get(did) or 0) for r in measured)
            seen = sum(1 for r in measured if int(r["rules"].get(did) or 0) > 0)
            share = seen / total if total else 0.0
            note = ""
            if total >= RULE_MIN_SESSIONS:
                note = "promote?" if share > RULE_PROMOTE_SHARE else ("unobserved" if not hits else "")
            say(f"{did[:38]:<38}{hits:>7}{seen:>10}{total:>6}{share:>8.0%}  {note}".rstrip())
        return 0

    if by == "stance":
        # A rescan stamps the stances of the minute it ran, not of the session it read, so a
        # session grouped by them would be filed under a variant it may never have run under.
        guessed = [r for r in measured if r.get("stances_source") == "rescan"]
        if guessed:
            say(f"{len(guessed)} rescanned session(s) excluded: stance not known at the time")
        measured = [r for r in measured if r.get("stances_source") != "rescan"]
        if not measured:
            say(f"no sessions with a known stance in the last {days} day(s)")
            return 0

    groups: Dict[str, List[Any]] = {}
    for row in measured:
        if by == "stance":
            stances = row.get("stances") if isinstance(row.get("stances"), dict) else {}
            keys = [f"{k}={v}" for k, v in sorted(stances.items())] or ["(no stances)"]
        else:
            keys = [row.get("repo") or "(no repo)"]
        for key in keys:
            acc = groups.setdefault(key, [0, {}])
            acc[0] += 1
            for did, n in row["rules"].items():
                acc[1][did] = acc[1].get(did, 0) + int(n or 0)
    head = f"{by:<42}{'sessions':>9}{'hits':>7}  top detectors"
    say(head)
    say("-" * len(head))
    for key in sorted(groups):
        sessions, counts = groups[key]
        top = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:3]
        say(f"{key[:42]:<42}{sessions:>9}{sum(counts.values()):>7}  "
            + (", ".join(f"{d} {n}" for d, n in top) or "-"))
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    """Summarize the session records the usage-log hook writes. Local file only."""
    path = state_dir() / "usage.jsonl"
    by = getattr(args, "by", "day")
    rules_mode = getattr(args, "rules", False) or by in ("rule", "stance")
    if rules_mode and by == "model":
        # Reporting something else silently would be worse than refusing: a rule hit belongs
        # to a session, and a session's hits cannot be attributed to one of its models.
        print("usage --rules groups by rule, repo or stance; --by model is not one of them",
              file=sys.stderr)
        return 2
    if rules_mode and by == "day":
        by = "rule"
    if getattr(args, "rescan", False):
        hook = REPO / "claude" / "hooks" / "usage-log.py"
        out = subprocess.run([sys.executable, str(hook), "--rescan", str(args.days)], capture_output=True, text=True)
        say((out.stdout or out.stderr).strip() or "rescan found no transcripts")
    cutoff = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - max(args.days, 0) * 86400))
    groups: Dict[str, List[int]] = {}
    kept: List[Dict[str, Any]] = []
    unknown_metrics = set()
    for line in (path.read_text(encoding="utf-8").splitlines() if path.exists() else []):
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict) or (row.get("ended") or "") < cutoff:
            continue
        if rules_mode:
            kept.append(row)
            continue
        if by == "repo":
            key = row.get("repo") or "(no repo)"
        elif by == "model":
            key = "+".join(row.get("models") or []) or "(unknown)"
        else:
            key = (row.get("ended") or "")[:10]
        acc = groups.setdefault(key, [0, 0, 0, 0, 0])
        acc[0] += 1
        for i, name in enumerate(("input", "output", "cache_read", "cache_write")):
            if row.get(name) is None:
                unknown_metrics.add(name)
            try:
                acc[i + 1] += int(row.get(name) or 0)
            except (TypeError, ValueError):
                pass
    if rules_mode:
        return rule_report(kept, by, args.days)
    if not groups:
        say(f"no sessions recorded in the last {args.days} day(s); looked in {path}")
        return 0

    def line_for(label: str, acc: List[int]) -> str:
        served = acc[1] + acc[3] + acc[4]
        hit = acc[3] / served if served else 0.0
        return (f"{label[:34]:<34}{acc[0]:>9}{acc[1]:>12,}{acc[2]:>12,}"
                f"{acc[3]:>14,}{acc[4]:>14,}{hit:>7.0%}")

    if unknown_metrics:
        say("Partial totals: unavailable metrics are excluded: " + ", ".join(sorted(unknown_metrics)))
    head = (f"{by:<34}{'sessions':>9}{'input':>12}{'output':>12}"
            f"{'cache_read':>14}{'cache_write':>14}{'hit':>7}")
    say(head)
    say("-" * len(head))
    total = [0, 0, 0, 0, 0]
    for key in sorted(groups):
        total = [t + a for t, a in zip(total, groups[key])]
        say(line_for(key, groups[key]))
    say("-" * len(head))
    say(line_for("TOTAL", total))
    return 0


# --------------------------------------------------------------------------- bmad

BMAD_TEMPLATES = REPO / "templates" / "bmad" / "custom"
BMAD_SUFFIX = ".user.toml"


def toml_surface(text: str) -> Tuple[set, set]:
    """Read declared customization keys and keyed layer ids structurally."""
    doc = reconcile.tomlkit.parse(text).unwrap()
    keys, entries = set(), set()
    def visit(value, prefix=""):
        for key, child in value.items():
            name = prefix + key
            if isinstance(child, dict):
                visit(child, name + ".")
            elif isinstance(child, list) and child and isinstance(child[0], dict):
                for item in child:
                    ident = item.get("id", item.get("code"))
                    if ident:
                        entries.add((name, ident))
            else:
                keys.add(name)
    visit(doc)
    return keys, entries


def _bmad_root(path: Optional[str]) -> Path:
    start = Path(path).expanduser() if path else Path.cwd()
    probe = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True)
    return Path(probe.stdout.strip()) if probe.returncode == 0 and probe.stdout.strip() else start.resolve()


def bmad_surface(root, skill):
    candidates = [root / folder / "skills" / skill / "customize.toml" for folder in (".agents", ".claude")]
    present = [path for path in candidates if path.is_file()]
    if len(present) == 2 and present[0].read_bytes() != present[1].read_bytes():
        raise ValueError("BMad skill projections disagree: " + skill)
    return present[0] if present else candidates[0]


def bmad_templates() -> List[Path]:
    return sorted(BMAD_TEMPLATES.glob(f"*{BMAD_SUFFIX}"))


def bmad_drift(template_text: str, base_text: str) -> List[str]:
    """Every key and layer id the template relies on that the installed skill no longer declares."""
    want_keys, want_entries = toml_surface(template_text)
    have_keys, have_entries = toml_surface(base_text)
    drift = [f"key `{key}` is not in the installed customize.toml" for key in sorted(want_keys - have_keys)]
    drift += [f"`{array}` has no entry `{ident}` in the installed customize.toml"
              for array, ident in sorted(want_entries - have_entries)]
    return drift


def bmad_check(root: Path) -> Tuple[List[str], List[str]]:
    """Status lines and drift findings, one template at a time, for the skills the repo has."""
    lines: List[str] = []
    drift: List[str] = []
    for template in bmad_templates():
        skill = template.name[: -len(BMAD_SUFFIX)]
        base = bmad_surface(root, skill)
        if not base.exists():
            lines.append(f"  {skill}: not installed here, skipped")
            continue
        text = template.read_text(encoding="utf-8")
        drift += [f"{skill}: {d}" for d in bmad_drift(text, base.read_text(encoding="utf-8"))]
        installed = root / "_bmad" / "custom" / template.name
        if not installed.exists():
            state = "template not installed (harness bmad apply)"
        elif installed.read_text(encoding="utf-8") == text:
            state = "installed"
        else:
            state = "installed, differs from the template"
        lines.append(f"  {skill}: {state}")
    return lines, drift


def bmad_apply(root: Path, force: bool) -> List[str]:
    """Install each template whose skill the repo has and whose surface still matches.

    One line per action taken or refused; nothing for a template already in place. A drifting
    template is skipped rather than written, so an upstream rename never adds a second layer."""
    actions: List[str] = []
    dest_dir = root / "_bmad" / "custom"
    for template in bmad_templates():
        skill = template.name[: -len(BMAD_SUFFIX)]
        base = bmad_surface(root, skill)
        if not base.exists():
            continue
        text = template.read_text(encoding="utf-8")
        dest = dest_dir / template.name
        rel = dest.relative_to(root)
        drift = bmad_drift(text, base.read_text(encoding="utf-8"))
        if drift:
            actions.append(f"  skipped {rel}: {len(drift)} drift finding(s), see harness bmad check")
            continue
        if dest.exists() and dest.read_text(encoding="utf-8") == text:
            continue
        if dest.exists() and not force:
            actions.append(f"  kept {rel}: differs from the template (--force replaces it)")
            continue
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest.write_text(text, encoding="utf-8")
        actions.append(f"  wrote {rel}")
    return actions


def cmd_bmad(args: argparse.Namespace) -> int:
    """`check` compares the override templates with a repository's installed BMad skills;
    `apply` installs the ones its skills declare and still match, never replacing a differing
    override without --force, then checks."""
    root = _bmad_root(args.path)
    if not (root / "_bmad").is_dir():
        say(f"no _bmad/ directory under {root}")
        return 1
    if args.action == "apply":
        for line in bmad_apply(root, args.force):
            say(line)
    lines, drift = bmad_check(root)
    for line in lines:
        say(line)
    for finding in drift:
        say("  drift: " + finding)
    say(f"bmad: {len(drift)} drift finding(s) in {root}")
    return 1 if drift else 0


def cmd_compatibility(args):
    data = compatibility.catalog(REPO)
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        say("Model provider and agent runtime are separate from the client you run.")
        for client in data["clients"]:
            say(client["id"] + ": " + client["status"])
        for limitation in data["limitations"]:
            say(limitation)
    if args.release_check:
        errors = compatibility.release_errors(REPO)
        for error in errors:
            print("release blocked: " + error, file=sys.stderr)
        return 1 if errors else 0
    return 0


def cmd_task(args):
    root = tasks.repository(Path(args.path or Path.cwd()))
    if args.action == "save":
        if not args.input:
            raise SystemExit("task save requires --input with a task contract JSON file")
        result = tasks.save(root, json.loads(Path(args.input).read_text()), args.runtime, args.revision)
    else:
        result = tasks.read(root)
    print(json.dumps(result, indent=2))
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="harness", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"agent-harness {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("install", help="full setup on a fresh machine, then sync")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-brew", action="store_true")
    p.add_argument("--no-apps", action="store_true")
    p.add_argument("--no-vscode", action="store_true")
    p.add_argument("--no-codex", action="store_true")
    p.add_argument("--with-optional", action="store_true", help="also install vscode/extensions.optional.txt")
    p.add_argument("--adopt", action="store_true", help="move pre-existing files aside so the harness can link")
    p.add_argument("--adopt-codex", action="store_true")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("sync", help="project shared primitives into selected runtimes and merge owned settings")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--adopt", action="store_true", help="move pre-existing files aside so the harness can link")
    p.add_argument("--adopt-codex", action="store_true", help="move a hand-written ~/.codex/AGENTS.md to AGENTS.personal.md")
    p.set_defaults(func=cmd_sync, print_only=False)

    p = sub.add_parser("catalog", help="emit the shared primitive catalog as JSON")
    p.set_defaults(func=cmd_catalog)

    p = sub.add_parser("generate", help="regenerate native source projections from shared primitives")
    p.add_argument("--check", action="store_true")
    p.set_defaults(func=cmd_generate)

    p = sub.add_parser("stances", help="show resolved personal stance switches and their behavior")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_stances)

    p = sub.add_parser("diff", help="report drift between checkout, last sync and live files")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_diff)

    p = sub.add_parser("doctor", help="versions, logins, links, drift")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("uninstall", help="remove links and owned settings, restore adopted files")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("lint", help="scan for personal-data shapes, lint terms, secret patterns, and the context cap")
    p.add_argument("path", nargs="?")
    p.add_argument("--staged", action="store_true", help="only the files staged in git (used by the pre-commit hook)")
    p.set_defaults(func=cmd_lint)

    p = sub.add_parser("usage", help="summarize recorded session tokens and cache hit rate")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("--by", choices=["day", "repo", "model", "rule", "stance"], default="day")
    p.add_argument("--rules", action="store_true",
                   help="report rule-detector hits instead of tokens (--by rule, repo or stance)")
    p.add_argument("--rescan", action="store_true", help="re-read transcripts from the window first, then report")
    p.set_defaults(func=cmd_usage)

    p = sub.add_parser("trust", help="let the stop-gate hook run a repository's `## Gate` block (default: the current repo)")
    p.add_argument("path", nargs="?")
    p.add_argument("--remove", action="store_true", help="forget the root instead")
    p.set_defaults(func=cmd_trust)

    p = sub.add_parser("workspace", help="create a multi-root workspace with a shared session store")
    p.add_argument("action")
    p.add_argument("name")
    p.add_argument("folders", nargs="*")
    p.add_argument("--no-harness", action="store_true")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_workspace)

    p = sub.add_parser("worktree", help="create and manage task checkouts under a dedicated root")
    worktree_sub = p.add_subparsers(dest="action", required=True)
    create = worktree_sub.add_parser("create", help="create ~/worktrees/REPO/NAME")
    create.add_argument("name")
    create.add_argument("repo", nargs="?")
    create.add_argument("--branch")
    create.add_argument("--base", default="origin/main")
    create.add_argument("--no-fetch", action="store_true")
    create.set_defaults(func=cmd_worktree)
    audit = worktree_sub.add_parser("audit", help="report clean, dirty, detached, and stale worktrees")
    audit.add_argument("repo", nargs="?")
    audit.set_defaults(func=cmd_worktree)
    remove = worktree_sub.add_parser("remove", help="remove a clean managed task checkout")
    remove.add_argument("name")
    remove.add_argument("repo", nargs="?")
    remove.set_defaults(func=cmd_worktree)

    p = sub.add_parser("init", help="write the config file by answering questions")
    p.add_argument("--force", action="store_true", help="replace an existing config file")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("config", help="read or write one config value, e.g. `config get identity.name`")
    p.add_argument("action", choices=["get", "set"])
    p.add_argument("key")
    p.add_argument("value", nargs="?")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("bmad", help="check or apply the BMad override templates in a repository (default: the current repo)")
    p.add_argument("action", choices=["check", "apply"])
    p.add_argument("path", nargs="?")
    p.add_argument("--force", action="store_true", help="apply: replace an override that differs from the template")
    p.set_defaults(func=cmd_bmad)

    p = sub.add_parser("compatibility", help="show versioned native qualification and adapter gaps")
    p.add_argument("--json", action="store_true")
    p.add_argument("--release-check", action="store_true", help="fail unless every release target has native evidence")
    p.set_defaults(func=cmd_compatibility)

    p = sub.add_parser("task", help="save or inspect a shared task continuation contract")
    p.add_argument("action", choices=["save", "show"])
    p.add_argument("path", nargs="?")
    p.add_argument("--input", help="JSON task contract; never executed")
    p.add_argument("--runtime", choices=["claude-code", "codex"], default=os.environ.get("HARNESS_RUNTIME", "codex"))
    p.add_argument("--revision", type=int, default=0, help="expected current revision; rejects stale writers")
    p.set_defaults(func=cmd_task)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
