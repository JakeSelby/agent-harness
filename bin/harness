#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Your way of working, across AI agents.

A user-aligned, model-provider-agnostic harness built on shared custom primitives.

Projects shared primitives into selected runtimes, merges owned settings, renders personal
guidance, and reports drift. Python 3.9+ with a bundled style-preserving TOML parser.

    harness init    [--force]
    harness install [--dry-run] [--no-brew] [--no-apps] [--no-vscode] [--no-codex] [--with-optional]
    harness sync    [--dry-run] [--adopt] [--adopt-codex]
    harness diff    [--quiet]
    harness doctor
    harness uninstall
    harness lint    [PATH]
    harness usage   [--days N] [--by day|repo|model] [--rescan]
    harness worktree create NAME [REPO] [--branch BRANCH] [--base BASE] [--no-fetch]
    harness worktree audit [REPO]
    harness worktree remove NAME [REPO]
    harness workspace create NAME FOLDER... [--no-harness] [--force]
    harness config get KEY | set KEY VALUE
    harness integrations show|register|doctor [architecture-viewer]
    harness viewer validate|open|status|replace-document|close [OPTIONS]
    harness bmad    check|apply [REPO] [--force]
    harness --version
"""
