#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""agent-harness command line.

Installs the harness into ~/.claude (symlinks), merges the settings keys it owns, renders the
personal file from config, keeps VS Code and Codex in step, and reports drift. Standard library
only, Python 3.9+.

    harness install [--dry-run] [--no-brew] [--no-apps] [--no-vscode] [--no-codex] [--with-optional]
    harness sync    [--dry-run] [--adopt] [--adopt-codex]
    harness diff    [--quiet]
    harness doctor
    harness uninstall
    harness lint    [PATH]
    harness usage   [--days N] [--by day|repo|model] [--rescan]
    harness workspace create NAME FOLDER... [--no-harness] [--force]
    harness config get KEY
    harness --version
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import time
from copy import deepcopy
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

REPO = Path(__file__).resolve().parent.parent
VERSION = (REPO / "VERSION").read_text().strip() if (REPO / "VERSION").exists() else "0.0.0"

STANCE_NAMES = ["licensing", "build-vs-buy", "commits", "plan-ceremony", "delegation", "testing", "autonomy", "cost"]
POSTURES = {
    "bypass": {"claude": "bypassPermissions", "vscode": "bypassPermissions", "codex": ("never", "danger-full-access")},
    "auto": {"claude": "auto", "vscode": None, "codex": ("on-failure", "workspace-write")},
    "manual": {"claude": "default", "vscode": "default", "codex": ("untrusted", "read-only")},
}
HARNESS_HOOK_BASENAMES = [
    "validate-plan-card.py", "allow-readonly-bash.py", "harness-session.py",
    "neutralize-tool-output.py",
]
LEGACY_RULES = [
    "decisions-and-plans.md", "delegation.md", "git-conventions.md", "licensing.md",
    "research-limits.md", "transcript-hygiene.md", "voice-and-format.md", "working-style.md",
]
PERSONAL_MARKER = "<!-- harness:personal-below -->"
CODEX_BANNER = "<!-- generated by agent-harness; edit the harness checkout or AGENTS.personal.md, not this file -->"
BREW_PACKAGES = ["git", "gh", "node@22", "pnpm", "uv", "ripgrep", "fd", "jq"]

# The lint carries NO list of real personal values. A denylist of real values is itself a
# disclosure the moment it is committed, which is exactly how the first release of this tool
# leaked identifiers. Instead:
#   - SHAPES below catch the classes of personal data by pattern, everywhere in the tree,
#     including this file and the tests;
#   - the maintainer's name and handle are derived from LICENSE and CODEOWNERS at run time and
#     are allowed in repo metadata but never inside installed content;
#   - specific terms (employer, town, hostnames, account ids) come from an untracked file,
#     ~/.config/agent-harness/lint-terms.txt, or the HARNESS_LINT_TERMS environment variable.
SHAPE_PATTERNS = [
    ("12-digit account id", r"(?<![\w.-])\d{12}(?![\w.-])"),
    ("email address", r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+"),
    ("home-directory path", r"/(?:Users|home)/[A-Za-z0-9._-]+/"),
    ("cloud ARN with account", r"arn:aws:[a-z0-9-]*:[a-z0-9-]*:\d{12}"),
    ("hosted-zone id", r"\bZ[0-9A-Z]{13,31}\b"),
    ("identity-provider tenant", r"\b[a-z0-9-]+\.(?:us|eu|au|jp)\.auth0\.com\b|\bdev-[a-z0-9]{16}\b"),
    ("private IPv4 address", r"\b(?:10|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}(?:\.\d{1,3})?\b"),
]
# The second pattern is split so this file does not contain the literal it hunts for.
SECRET_PATTERNS = [
    r"AKIA[0-9A-Z]{16}", r"(?i)aws_secret" r"_access_key", r"Bearer [A-Za-z0-9._-]{20,}",
    r"(?i)client_secret\s*[:=]", r"-----BEGIN [A-Z ]*PRIVATE KEY-----", r"xox[bp]-", r"ghp_[A-Za-z0-9]{20,}",
    r"sk-[A-Za-z0-9]{20,}",
]
# Everything in `claude/CLAUDE.md`, `claude/rules/` and one variant of every stance is re-read on
# every turn of every session, so its size is a standing tax on every task. The cap is enforced by
# `harness lint`; the stance count uses the LONGEST variant of each dimension, so no selection a
# user can make is ever over it. Rationale: docs/how-it-works.md.
ALWAYS_LOADED_CAP = 200

NAME_FORBIDDEN_DIRS = {"claude", "vscode", "codex", "templates"}
NAME_FORBIDDEN_FILES = {"config.example.json"}
LINT_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".pytest_cache"}


def lint_terms_path() -> Path:
    return home() / ".config" / "agent-harness" / "lint-terms.txt"


def load_lint_terms(env: Optional[Dict[str, str]] = None) -> Tuple[List[str], List[str]]:
    """Returns (terms forbidden everywhere, terms allowed only under docs/), lower-cased."""
    env = os.environ if env is None else env
    everywhere: List[str] = []
    docs_ok: List[str] = []
    lines: List[str] = []
    if lint_terms_path().exists():
        lines += lint_terms_path().read_text(encoding="utf-8").splitlines()
    lines += [t for t in env.get("HARNESS_LINT_TERMS", "").split(",")]
    for raw in lines:
        t = raw.strip()
        if not t or t.startswith("#"):
            continue
        if t.lower().startswith("docs-ok:"):
            docs_ok.append(t[len("docs-ok:"):].strip().lower())
        else:
            everywhere.append(t.lower())
    return everywhere, docs_ok


def maintainer_terms(root: Path) -> List[str]:
    """Name tokens from the LICENSE copyright line and the handle from CODEOWNERS."""
    terms: List[str] = []
    lic = root / "LICENSE"
    if lic.exists():
        for line in lic.read_text(encoding="utf-8").splitlines():
            m = re.match(r"\s*Copyright \(c\) \d{4}\s+(.+)", line)
            if m:
                terms += [w for w in re.findall(r"[A-Za-z][A-Za-z'-]{2,}", m.group(1))]
                break
    co = root / ".github" / "CODEOWNERS"
    if co.exists():
        terms += re.findall(r"@([A-Za-z0-9-]+)", co.read_text(encoding="utf-8"))
    return sorted(set(terms))


# --------------------------------------------------------------------------- paths


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def claude_dir() -> Path:
    return home() / ".claude"


def config_path() -> Path:
    return home() / ".config" / "agent-harness" / "config.json"


def state_dir() -> Path:
    return home() / ".local" / "state" / "agent-harness"


def manifest_path() -> Path:
    return state_dir() / "manifest.json"


def applied_path() -> Path:
    return state_dir() / "applied.json"


def vscode_settings_path() -> Path:
    if os.environ.get("HARNESS_VSCODE_SETTINGS"):
        return Path(os.environ["HARNESS_VSCODE_SETTINGS"])
    if platform.system() == "Darwin":
        return home() / "Library" / "Application Support" / "Code" / "User" / "settings.json"
    return home() / ".config" / "Code" / "User" / "settings.json"


def codex_dir() -> Path:
    return home() / ".codex"


def global_gitignore_path() -> Path:
    return home() / ".config" / "git" / "ignore"


# --------------------------------------------------------------------------- io helpers


def read_json(path: Path) -> Optional[Dict[str, Any]]:
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{path} is not valid JSON ({exc}); fix it or remove it and re-run")


def write_json_atomic(path: Path, data: Dict[str, Any], expect_mtime: Optional[float] = None, backup: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if expect_mtime is not None and path.exists() and abs(path.stat().st_mtime - expect_mtime) > 1e-6:
        raise SystemExit(f"{path} changed while harness was running; nothing written. Re-run.")
    if backup and path.exists():
        shutil.copy2(path, path.with_suffix(path.suffix + ".bak"))
    tmp = path.with_name(path.name + ".harness-tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


def say(msg: str) -> None:
    if os.environ.get("HARNESS_QUIET"):
        return
    print(msg)


# --------------------------------------------------------------------------- config


def load_config(env: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
    env = os.environ if env is None else env
    base = read_json(REPO / "config.example.json") or {}
    user = read_json(config_path()) or {}
    cfg = deepcopy(base)
    for key, value in user.items():
        if isinstance(value, dict) and isinstance(cfg.get(key), dict):
            cfg[key].update(value)
        else:
            cfg[key] = value
    cfg.setdefault("stances", {})
    cfg.setdefault("identity", {})
    for key, value in env.items():
        if key.startswith("HARNESS_STANCE_"):
            cfg["stances"][key[len("HARNESS_STANCE_"):].lower().replace("_", "-")] = value
        elif key.startswith("HARNESS_IDENTITY_"):
            cfg["identity"][key[len("HARNESS_IDENTITY_"):].lower()] = value
        elif key == "HARNESS_PERMISSIONS":
            cfg["permissions"] = value
        elif key == "HARNESS_MANAGE_VSCODE":
            cfg.setdefault("vscode", {})["manage"] = value not in ("0", "false", "no")
        elif key == "HARNESS_MANAGE_CODEX":
            cfg.setdefault("codex", {})["manage"] = value not in ("0", "false", "no")
    return cfg


def resolve_stances(cfg: Dict[str, Any]) -> Dict[str, Path]:
    out: Dict[str, Path] = {}
    for name in STANCE_NAMES:
        variant = cfg["stances"].get(name)
        if not variant:
            raise SystemExit(f"config has no variant for stance '{name}'")
        path = REPO / "claude" / "stances" / name / f"{variant}.md"
        if not path.exists():
            options = sorted(p.stem for p in (REPO / "claude" / "stances" / name).glob("*.md"))
            raise SystemExit(f"stance '{name}' has no variant '{variant}'; options: {', '.join(options)}")
        out[name] = path
    return out


def posture(cfg: Dict[str, Any]) -> str:
    value = cfg.get("permissions", "inherit")
    if value not in ("inherit",) and value not in POSTURES:
        raise SystemExit(f"permissions must be inherit, bypass, auto or manual; got '{value}'")
    if value == "bypass" and cfg.get("permissions_bypass_acknowledged") is not True:
        raise SystemExit(
            "permissions=bypass turns off every permission prompt in Claude Code and VS Code and puts "
            "Codex in danger-full-access with no sandbox. Never use it on a machine that touches "
            "regulated or customer data. To confirm you mean it, set "
            "\"permissions_bypass_acknowledged\": true in ~/.config/agent-harness/config.json."
        )
    return value


# --------------------------------------------------------------------------- settings merge


def _hook_marker(entry: Dict[str, Any]) -> Optional[str]:
    for h in entry.get("hooks", []):
        m = re.search(r"# harness:([a-z0-9-]+)", h.get("command", ""))
        if m:
            return m.group(1)
    return None


def _is_harness_entry(entry: Dict[str, Any]) -> bool:
    if _hook_marker(entry):
        return True
    for h in entry.get("hooks", []):
        cmd = h.get("command", "")
        if any(b in cmd for b in HARNESS_HOOK_BASENAMES):
            return True
    return False


def merge_claude_settings(live: Dict[str, Any], template: Dict[str, Any], cfg: Dict[str, Any]) -> Dict[str, Any]:
    out = deepcopy(live) if live else {}
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    owned = ownership.get("claude", {}).get("owned_keys", [])
    for key in owned:
        if key in template:
            out[key] = template[key]
    perms = out.setdefault("permissions", {})
    p = posture(cfg)
    if p != "inherit":
        perms["defaultMode"] = POSTURES[p]["claude"]
    allow = list(perms.get("allow", []))
    for rule in template.get("permissions", {}).get("allow", []):
        if rule not in allow:
            allow.append(rule)
    perms["allow"] = allow
    hooks = out.setdefault("hooks", {})
    plan_variant = cfg["stances"].get("plan-ceremony")
    hook_ids = ownership.get("claude", {}).get("hook_ids", {})
    for event, entries in template.get("hooks", {}).items():
        kept = [e for e in hooks.get(event, []) if not _is_harness_entry(e)]
        for entry in entries:
            hid = _hook_marker(entry)
            spec = hook_ids.get(hid, {})
            if spec.get("stance") and cfg["stances"].get(spec["stance"]) != spec.get("variant"):
                continue
            kept.append(deepcopy(entry))
        if kept:
            hooks[event] = kept
        elif event in hooks:
            del hooks[event]
    # Drop harness entries from events the template no longer defines.
    for event in list(hooks.keys()):
        if event not in template.get("hooks", {}):
            hooks[event] = [e for e in hooks[event] if not _is_harness_entry(e)]
            if not hooks[event]:
                del hooks[event]
    if not hooks:
        out.pop("hooks", None)
    return out


def strip_claude_settings(live: Dict[str, Any], template: Dict[str, Any]) -> Dict[str, Any]:
    out = deepcopy(live) if live else {}
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    for key in ownership.get("claude", {}).get("owned_keys", []):
        out.pop(key, None)
    perms = out.get("permissions", {})
    if "allow" in perms:
        tmpl = set(template.get("permissions", {}).get("allow", []))
        perms["allow"] = [r for r in perms["allow"] if r not in tmpl]
    hooks = out.get("hooks", {})
    for event in list(hooks.keys()):
        hooks[event] = [e for e in hooks[event] if not _is_harness_entry(e)]
        if not hooks[event]:
            del hooks[event]
    if not hooks:
        out.pop("hooks", None)
    return out


def claude_projection(settings: Dict[str, Any], template: Dict[str, Any]) -> Dict[str, Any]:
    """The slice of a settings file the harness cares about, for diffing."""
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    owned = ownership.get("claude", {}).get("owned_keys", [])
    proj: Dict[str, Any] = {"keys": {k: settings.get(k) for k in owned}}
    proj["defaultMode"] = settings.get("permissions", {}).get("defaultMode")
    proj["allow"] = sorted(settings.get("permissions", {}).get("allow", []))
    proj["hooks"] = sorted(
        h for entries in settings.get("hooks", {}).values() for e in entries for h in [_hook_marker(e)] if h
    )
    return proj


def merge_vscode_settings(live: Dict[str, Any], owned: Dict[str, Any], cfg: Dict[str, Any]) -> Dict[str, Any]:
    out = deepcopy(live) if live else {}
    out.update(owned)
    p = posture(cfg)
    if p != "inherit":
        mode = POSTURES[p]["vscode"]
        if mode is None:
            out.pop("claudeCode.initialPermissionMode", None)
        else:
            out["claudeCode.initialPermissionMode"] = mode
        out["claudeCode.allowDangerouslySkipPermissions"] = (p == "bypass")
    return out


# --------------------------------------------------------------------------- links


def _record(manifest: Dict[str, Any], kind: str, item: Dict[str, Any]) -> None:
    manifest.setdefault(kind, [])
    manifest[kind] = [i for i in manifest[kind] if i.get("path") != item.get("path")]
    manifest[kind].append(item)


def _adopt(path: Path, manifest: Dict[str, Any], dry: bool) -> Optional[Path]:
    """Move a pre-existing unmanaged path aside so the harness can link there."""
    dest_dir = state_dir() / "pre-harness"
    rel = path.relative_to(home())
    dest = dest_dir / rel
    say(f"  adopt   {path}  ->  {dest}")
    if not dry:
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.exists() or dest.is_symlink():
            dest = dest.with_name(dest.name + f".{int(time.time())}")
        shutil.move(str(path), str(dest))
        _record(manifest, "adopted", {"path": str(path), "moved_to": str(dest)})
    return dest


def ensure_link(path: Path, target: Path, manifest: Dict[str, Any], dry: bool, adopt: bool, report: List[str]) -> None:
    managed = any(l.get("path") == str(path) for l in manifest.get("links", []))
    if path.is_symlink():
        current = Path(os.readlink(path))
        if current == target or path.resolve() == target.resolve():
            _record(manifest, "links", {"path": str(path), "target": str(target)})
            return
        if managed or adopt:
            say(f"  relink  {path}")
            if not dry:
                path.unlink()
                path.symlink_to(target)
            _record(manifest, "links", {"path": str(path), "target": str(target)})
            return
        report.append(f"{path} is a symlink to {current}, not managed by the harness; pass --adopt to replace it")
        return
    if path.exists():
        if adopt:
            _adopt(path, manifest, dry)
        else:
            report.append(f"{path} exists and is not a harness link; pass --adopt to move it aside")
            return
    say(f"  link    {path}  ->  {target}")
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)
    _record(manifest, "links", {"path": str(path), "target": str(target)})


def link_dir_files(source: Path, dest: Path, manifest: Dict[str, Any], dry: bool, adopt: bool,
                   report: List[str]) -> None:
    """One link per file, so anything the user keeps in the destination directory survives."""
    wanted = set()
    if source.is_dir():
        for f in sorted(p_ for p_ in source.iterdir() if p_.is_file()):
            link = dest / f.name
            wanted.add(str(link))
            ensure_link(link, f, manifest, dry, adopt, report)
    for old in list(manifest.get("links", [])):
        if Path(old["path"]).parent == dest and old["path"] not in wanted:
            say(f"  unlink  {old['path']} (no longer in the harness)")
            if not dry and Path(old["path"]).is_symlink():
                Path(old["path"]).unlink()
            manifest["links"].remove(old)


def adopt_legacy(path: Path, manifest: Dict[str, Any], dry: bool, adopt: bool, report: List[str]) -> None:
    """A plain file the harness now supplies elsewhere; move it aside so it does not load twice."""
    if not path.exists() or path.is_symlink():
        return
    if adopt:
        _adopt(path, manifest, dry)
    else:
        report.append(f"{path} duplicates a harness file and would load twice; pass --adopt to move it aside")


# --------------------------------------------------------------------------- personal file, codex, gitignore


def render_personal(cfg: Dict[str, Any], existing: Optional[str]) -> str:
    template = (REPO / "claude" / "CLAUDE.personal.template.md").read_text(encoding="utf-8")
    identity = {k: cfg.get("identity", {}).get(k, "") for k in ("name", "pronouns", "role", "github", "timezone")}
    head = template.format_map(identity)
    if existing and PERSONAL_MARKER in existing:
        tail = existing.split(PERSONAL_MARKER, 1)[1]
        head = head.split(PERSONAL_MARKER, 1)[0] + PERSONAL_MARKER + tail
    return head


def render_codex_agents(stances: Dict[str, Path], personal: Optional[str]) -> str:
    parts = [CODEX_BANNER, ""]
    claude_md = (REPO / "claude" / "CLAUDE.md").read_text(encoding="utf-8")
    claude_md = "\n".join(l for l in claude_md.splitlines() if not l.startswith("@")).rstrip()
    parts += [claude_md, ""]
    for rule in sorted((REPO / "claude" / "rules").glob("*.md")):
        parts += ["---", f"<!-- {rule.name} -->", rule.read_text(encoding="utf-8").rstrip(), ""]
    for name in STANCE_NAMES:
        path = stances[name]
        parts += ["---", f"<!-- stance {name}: {path.stem} -->", path.read_text(encoding="utf-8").rstrip(), ""]
    if personal:
        parts += ["---", "<!-- AGENTS.personal.md -->", personal.rstrip(), ""]
    return "\n".join(parts)


def update_codex_config(text: str, cfg: Dict[str, Any]) -> str:
    lines = text.splitlines()
    wanted = {"project_doc_fallback_filenames": 'project_doc_fallback_filenames = ["CLAUDE.md"]'}
    p = posture(cfg)
    if p != "inherit":
        approval, sandbox = POSTURES[p]["codex"]
        wanted["approval_policy"] = f'approval_policy = "{approval}"'
        wanted["sandbox_mode"] = f'sandbox_mode = "{sandbox}"'
    seen = set()
    out = []
    for line in lines:
        key = line.split("=", 1)[0].strip()
        if key in wanted and not line.lstrip().startswith("#") and not line.lstrip().startswith("["):
            out.append(wanted[key])
            seen.add(key)
        else:
            out.append(line)
    missing = [wanted[k] for k in wanted if k not in seen]
    if missing:
        # Top-level keys must precede any [table]; insert before the first table header.
        idx = next((i for i, l in enumerate(out) if l.lstrip().startswith("[")), len(out))
        out[idx:idx] = ["# agent-harness owned keys"] + missing + [""]
    return "\n".join(out) + ("\n" if out and out[-1] != "" else "")


def ensure_gitignore_entries(dry: bool) -> None:
    ownership = read_json(REPO / "claude" / "OWNERSHIP.json") or {}
    entries = ownership.get("gitignore_entries", [])
    path = global_gitignore_path()
    existing = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    missing = [e for e in entries if e not in existing]
    if not missing:
        return
    say(f"  ignore  {path}: + {', '.join(missing)}")
    if not dry:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            if existing and existing[-1] != "":
                fh.write("\n")
            fh.write("# agent-harness\n" + "\n".join(missing) + "\n")


def ensure_local_bin_on_path(dry: bool) -> None:
    if platform.system() != "Darwin" or "zsh" not in os.environ.get("SHELL", ""):
        return
    for name in (".zprofile", ".zshrc"):
        f = home() / name
        if f.exists() and ".local/bin" in f.read_text(encoding="utf-8"):
            return
    target = home() / ".zprofile"
    say(f"  path    ~/.local/bin added to PATH in {target}")
    if not dry:
        with open(target, "a", encoding="utf-8") as fh:
            fh.write('\n# agent-harness: Claude Code native launcher lives here\nexport PATH="$HOME/.local/bin:$PATH"\n')


# --------------------------------------------------------------------------- commands


def cmd_sync(args: argparse.Namespace) -> int:
    dry = args.dry_run
    cfg = load_config()
    stances = resolve_stances(cfg)
    p = posture(cfg)
    say(f"agent-harness {VERSION} · repo {REPO} · home {home()}{' · DRY RUN' if dry else ''}")
    say("stances: " + ", ".join(f"{k}={v.stem}" for k, v in stances.items()) + f" · permissions={p}")
    if args.dry_run and getattr(args, "print_only", False):
        return 0

    manifest = read_json(manifest_path()) or {"version": 1}
    manifest["repo"] = str(REPO)
    report: List[str] = []
    cd = claude_dir()
    if not dry:
        for sub in ("rules", "skills", "agents", "hooks", "output-styles", "plans"):
            (cd / sub).mkdir(parents=True, exist_ok=True)
        (cd / "rules" / "harness-stances").mkdir(exist_ok=True)
        state_dir().mkdir(parents=True, exist_ok=True)
        if not config_path().exists():
            config_path().parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(REPO / "config.example.json", config_path())
            say(f"  config  created {config_path()} from config.example.json — edit identity and stances")

    # Legacy plain files that the harness now provides.
    for name in LEGACY_RULES:
        adopt_legacy(cd / "rules" / name, manifest, dry, args.adopt, report)
    for name in HARNESS_HOOK_BASENAMES:
        adopt_legacy(cd / "hooks" / name, manifest, dry, args.adopt, report)

    # Links.
    ensure_link(cd / "rules" / "harness", REPO / "claude" / "rules", manifest, dry, args.adopt, report)
    wanted_stance_links = set()
    for name, target in stances.items():
        link = cd / "rules" / "harness-stances" / f"{name}.md"
        wanted_stance_links.add(str(link))
        ensure_link(link, target, manifest, dry, args.adopt, report)
    for old in list(manifest.get("links", [])):
        if "/rules/harness-stances/" in old["path"] and old["path"] not in wanted_stance_links:
            say(f"  unlink  {old['path']} (stance no longer selected)")
            if not dry and Path(old["path"]).is_symlink():
                Path(old["path"]).unlink()
            manifest["links"].remove(old)
    for skill in sorted(p_ for p_ in (REPO / "claude" / "skills").iterdir() if p_.is_dir()):
        ensure_link(cd / "skills" / skill.name, skill, manifest, dry, args.adopt, report)
    for agent in sorted((REPO / "claude" / "agents").glob("*.md")):
        ensure_link(cd / "agents" / agent.name, agent, manifest, dry, args.adopt, report)
    ensure_link(cd / "hooks" / "harness", REPO / "claude" / "hooks", manifest, dry, args.adopt, report)
    for style in sorted((REPO / "claude" / "output-styles").glob("*.md")):
        ensure_link(cd / "output-styles" / style.name, style, manifest, dry, args.adopt, report)
    link_dir_files(REPO / "claude" / "commands", cd / "commands", manifest, dry, args.adopt, report)
    ensure_link(cd / "CLAUDE.md", REPO / "claude" / "CLAUDE.md", manifest, dry, args.adopt, report)

    # Personal file.
    personal = cd / "CLAUDE.personal.md"
    existing = personal.read_text(encoding="utf-8") if personal.exists() else None
    rendered = render_personal(cfg, existing)
    if rendered != existing:
        say(f"  render  {personal}")
        if not dry:
            personal.write_text(rendered, encoding="utf-8")

    # Claude settings.
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    settings_file = cd / "settings.json"
    live = read_json(settings_file) or {}
    mtime = settings_file.stat().st_mtime if settings_file.exists() else None
    merged = merge_claude_settings(live, template, cfg)
    applied = read_json(applied_path()) or {}
    if merged != live:
        say(f"  merge   {settings_file}")
        if not dry:
            write_json_atomic(settings_file, merged, expect_mtime=mtime, backup=True)
    applied["claude"] = claude_projection(merged, template)
    applied["template"] = claude_projection(merge_claude_settings({}, template, cfg), template)

    # VS Code.
    if cfg.get("vscode", {}).get("manage", True):
        vs = vscode_settings_path()
        if vs.exists():
            try:
                vlive = read_json(vs) or {}
            except SystemExit:
                vlive = None
                report.append(f"{vs} is not plain JSON (comments?); VS Code settings left alone")
            if vlive is not None:
                owned = read_json(REPO / "vscode" / "settings.owned.json") or {}
                vmerged = merge_vscode_settings(vlive, owned, cfg)
                if vmerged != vlive:
                    say(f"  merge   {vs}")
                    if not dry:
                        write_json_atomic(vs, vmerged, expect_mtime=vs.stat().st_mtime, backup=True)
                applied["vscode"] = {k: vmerged.get(k) for k in list(owned) + ["claudeCode.initialPermissionMode", "claudeCode.allowDangerouslySkipPermissions"]}
        else:
            say("  vscode  no user settings file found; skipping (install VS Code, then re-run sync)")

    # Codex.
    if cfg.get("codex", {}).get("manage", True) and codex_dir().exists():
        agents = codex_dir() / "AGENTS.md"
        personal_codex = codex_dir() / "AGENTS.personal.md"
        if agents.exists() and not agents.read_text(encoding="utf-8").startswith(CODEX_BANNER):
            if args.adopt_codex:
                say(f"  adopt   {agents} -> {personal_codex}")
                if not dry:
                    if personal_codex.exists():
                        personal_codex = personal_codex.with_name(f"AGENTS.personal.{int(time.time())}.md")
                    shutil.move(str(agents), str(personal_codex))
            else:
                report.append(f"{agents} is not harness-generated; pass --adopt-codex to move it to AGENTS.personal.md and regenerate")
        if not agents.exists() or agents.read_text(encoding="utf-8").startswith(CODEX_BANNER):
            ptext = personal_codex.read_text(encoding="utf-8") if personal_codex.exists() else None
            text = render_codex_agents(stances, ptext)
            if not agents.exists() or agents.read_text(encoding="utf-8") != text:
                say(f"  render  {agents}")
                if not dry:
                    agents.write_text(text, encoding="utf-8")
        ctoml = codex_dir() / "config.toml"
        if ctoml.exists():
            new = update_codex_config(ctoml.read_text(encoding="utf-8"), cfg)
            if new != ctoml.read_text(encoding="utf-8"):
                say(f"  update  {ctoml} (owned keys)")
                if not dry:
                    shutil.copy2(ctoml, ctoml.with_suffix(".toml.bak"))
                    ctoml.write_text(new, encoding="utf-8")
        else:
            say(f"  create  {ctoml} from codex/config.toml.example")
            if not dry:
                ctoml.write_text(update_codex_config((REPO / "codex" / "config.toml.example").read_text(encoding="utf-8"), cfg), encoding="utf-8")

    ensure_gitignore_entries(dry)
    ensure_local_bin_on_path(dry)
    # The harness checkout lints every commit before it is made.
    if (REPO / ".githooks" / "pre-commit").exists() and not dry:
        subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath", ".githooks"], capture_output=True)

    manifest["synced_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    manifest["config"] = {"stances": cfg["stances"], "permissions": p}
    if not dry:
        write_json_atomic(manifest_path(), manifest)
        write_json_atomic(applied_path(), applied)
    if report:
        say("\nNeeds your attention:")
        for r in report:
            say("  - " + r)
        return 2
    say("sync complete")
    return 0


def _diff_lines() -> List[str]:
    lines: List[str] = []
    manifest = read_json(manifest_path())
    if not manifest:
        return ["harness not synced yet (no manifest); run `harness sync`"]
    for link in manifest.get("links", []):
        p = Path(link["path"])
        if not p.is_symlink():
            lines.append(f"missing link {p}")
        elif Path(os.readlink(p)) != Path(link["target"]):
            lines.append(f"redirected link {p} -> {os.readlink(p)}")
        elif not p.exists():
            lines.append(f"broken link {p}")
    cfg = load_config()
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    applied = read_json(applied_path()) or {}
    live = read_json(claude_dir() / "settings.json") or {}
    live_p = claude_projection(live, template)
    applied_p = applied.get("claude", {})
    template_p = claude_projection(merge_claude_settings({}, template, cfg), template)
    if applied_p:
        for k, v in live_p["keys"].items():
            if applied_p.get("keys", {}).get(k) != v:
                lines.append(f"live-only change: settings.{k} = {v!r} (upstream it or re-sync)")
        for rule in live_p["allow"]:
            if rule not in applied_p.get("allow", []) and rule not in template_p["allow"]:
                lines.append(f"live-only allow rule: {rule} (upstream?)")
        for rule in template_p["allow"]:
            if rule not in live_p["allow"]:
                lines.append(f"pending sync: allow rule {rule}")
        for hid in template_p["hooks"]:
            if hid not in live_p["hooks"]:
                lines.append(f"pending sync: hook {hid}")
        if applied.get("template") and applied["template"] != template_p:
            lines.append("pending sync: settings template changed since last sync")
    stances_now = {k: cfg["stances"].get(k) for k in STANCE_NAMES}
    if manifest.get("config", {}).get("stances") and manifest["config"]["stances"] != stances_now:
        lines.append("pending sync: stance selection changed since last sync")
    return lines


def _checkout_state() -> str:
    try:
        ref = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, timeout=5).stdout.strip()
        dirty = subprocess.run(["git", "-C", str(REPO), "status", "--porcelain"], capture_output=True, text=True, timeout=5).stdout.strip()
        ahead = subprocess.run(["git", "-C", str(REPO), "rev-list", "--count", "@{upstream}..HEAD"], capture_output=True, text=True, timeout=5).stdout.strip()
        parts = [ref or "?"]
        if dirty:
            parts.append(f"{len(dirty.splitlines())} uncommitted file(s)")
        if ahead and ahead != "0":
            parts.append(f"{ahead} unpushed commit(s)")
        return " · ".join(parts)
    except Exception:
        return "unknown"


def cmd_diff(args: argparse.Namespace) -> int:
    lines = _diff_lines()
    if not lines:
        if not args.quiet:
            say("no drift")
        return 0
    if args.quiet:
        say(f"{len(lines)} item(s): " + "; ".join(lines[:3]) + (" …" if len(lines) > 3 else ""))
    else:
        for l in lines:
            say("- " + l)
    return 1


def _version_of(cmd: List[str]) -> str:
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return (out.stdout or out.stderr).strip().splitlines()[0] if (out.stdout or out.stderr).strip() else "installed"
    except FileNotFoundError:
        return "not installed"
    except Exception as exc:
        return f"error: {exc}"


def cmd_doctor(args: argparse.Namespace) -> int:
    say(f"agent-harness {VERSION}")
    say(f"  repo: {REPO}")
    say(f"  checkout: {_checkout_state()}")
    for name, cmd in (("claude", ["claude", "--version"]), ("code", ["code", "--version"]), ("codex", ["codex", "--version"]), ("gh", ["gh", "--version"]), ("python3", [sys.executable, "--version"])):
        say(f"  {name}: {_version_of(cmd)}")
    say(f"  gh login: {_version_of(['gh', 'auth', 'status'])}")
    say(f"  claude credentials present: {(claude_dir() / '.credentials.json').exists() or (home() / '.claude.json').exists()}")
    say(f"  codex credentials present: {(codex_dir() / 'auth.json').exists()}")
    for hook in (REPO / "claude" / "hooks").glob("*.py"):
        say(f"  hook {hook.name}: {'executable' if os.access(hook, os.X_OK) else 'not executable (python3 is invoked explicitly, fine)'}")
    lines = _diff_lines()
    say("  drift: " + ("none" if not lines else f"{len(lines)} item(s), run `harness diff`"))
    if shutil.which("claude"):
        say("  claude doctor:")
        try:
            out = subprocess.run(["claude", "doctor"], capture_output=True, text=True, timeout=60)
            for l in (out.stdout or out.stderr).strip().splitlines()[:20]:
                say("    " + l)
        except Exception as exc:
            say(f"    could not run: {exc}")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    manifest = read_json(manifest_path())
    if not manifest:
        say("nothing to uninstall (no manifest)")
        return 0
    for link in manifest.get("links", []):
        p = Path(link["path"])
        if p.is_symlink():
            p.unlink()
            say(f"  unlink  {p}")
    for item in manifest.get("adopted", []):
        src, dst = Path(item["moved_to"]), Path(item["path"])
        if src.exists() and not dst.exists():
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(src), str(dst))
            say(f"  restore {dst}")
    template = read_json(REPO / "claude" / "settings.template.json") or {}
    sf = claude_dir() / "settings.json"
    live = read_json(sf)
    if live is not None:
        write_json_atomic(sf, strip_claude_settings(live, template), backup=True)
        say(f"  strip   {sf}")
    agents = codex_dir() / "AGENTS.md"
    if agents.exists() and agents.read_text(encoding="utf-8").startswith(CODEX_BANNER):
        agents.unlink()
        pc = codex_dir() / "AGENTS.personal.md"
        if pc.exists():
            shutil.move(str(pc), str(agents))
        say(f"  restore {agents}")
    for f in (manifest_path(), applied_path()):
        if f.exists():
            f.unlink()
    say("uninstalled; personal files, config and the checkout are untouched")
    return 0


def lint_files(root: Path, files: List[Path], terms: Optional[Tuple[List[str], List[str]]] = None) -> List[str]:
    """Lint the given files (paths under root). No file is exempt, including this one."""
    hits: List[str] = []
    everywhere, docs_ok = terms if terms is not None else load_lint_terms()
    names = [re.compile(r"(?i)\b" + re.escape(t) + r"\b") for t in maintainer_terms(root)]
    docs_only = [re.compile(r"(?i)\b" + re.escape(t) + r"\b") for t in docs_ok]
    shapes = [(label, re.compile(p)) for label, p in SHAPE_PATTERNS]
    secrets = [re.compile(p) for p in SECRET_PATTERNS]
    for path in files:
        if not path.is_file() or path.is_symlink():
            continue
        rel = path.relative_to(root)
        if any(part in LINT_SKIP_DIRS for part in rel.parts):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        installed = rel.parts[0] in NAME_FORBIDDEN_DIRS or rel.name in NAME_FORBIDDEN_FILES
        for n, line in enumerate(text.splitlines(), 1):
            low = line.lower()
            for term in everywhere:
                if term in low:
                    hits.append(f"{rel}:{n}: personal term from lint-terms file")
            if rel.parts[0] != "docs":
                for rx in docs_only:
                    if rx.search(line):
                        hits.append(f"{rel}:{n}: project name allowed only under docs/")
            if installed:
                for rx in names:
                    if rx.search(line):
                        hits.append(f"{rel}:{n}: maintainer name in installed content")
            for label, rx in shapes:
                if rx.search(line):
                    hits.append(f"{rel}:{n}: {label}")
            for rx in secrets:
                if rx.search(line):
                    hits.append(f"{rel}:{n}: secret pattern {rx.pattern}")
    return hits


def lint_tree(root: Path, terms: Optional[Tuple[List[str], List[str]]] = None) -> List[str]:
    """Lint everything git would commit: tracked files plus untracked files that are not ignored.
    Outside a git repository, every file."""
    try:
        out = subprocess.run(["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode == 0:
            files = sorted(root / f for f in out.stdout.split("\0") if f)
            return lint_files(root, files, terms)
    except Exception:
        pass
    return lint_files(root, sorted(p for p in root.rglob("*") if p.is_file()), terms)


def _line_count(path: Path) -> int:
    return len(path.read_text(encoding="utf-8").splitlines())


def always_loaded_lines(root: Path) -> Tuple[int, List[Tuple[str, int]]]:
    """Line counts of everything loaded on every turn, as (total, [(group, lines)]).

    The stance total is the worst case — the longest variant of each dimension — so the cap holds
    for every selection a user could make, not only the default one.
    """
    groups: List[Tuple[str, int]] = []
    claude_md = root / "claude" / "CLAUDE.md"
    if claude_md.is_file():
        groups.append(("claude/CLAUDE.md", _line_count(claude_md)))
    rules = sorted((root / "claude" / "rules").glob("*.md"))
    if rules:
        plural = "file" if len(rules) == 1 else "files"
        groups.append((f"claude/rules/ ({len(rules)} {plural})", sum(_line_count(p) for p in rules)))
    stances = root / "claude" / "stances"
    if stances.is_dir():
        for d in sorted(p for p in stances.iterdir() if p.is_dir()):
            variants = sorted(d.glob("*.md"))
            if not variants:
                continue
            worst = max(variants, key=lambda p: (_line_count(p), p.name))
            groups.append((f"claude/stances/{d.name}/ (longest: {worst.name})", _line_count(worst)))
    return sum(n for _, n in groups), groups


def check_context_cap(root: Path) -> List[str]:
    """Fail when always-loaded context exceeds the cap, printing the breakdown."""
    total, groups = always_loaded_lines(root)
    if not groups or total <= ALWAYS_LOADED_CAP:
        return []
    hits = [f"context-cap: always-loaded context is {total} lines, over the {ALWAYS_LOADED_CAP}-line cap"]
    for name, n in sorted(groups, key=lambda g: (-g[1], g[0])):
        hits.append(f"context-cap:   {n:4d}  {name}")
    hits.append("context-cap: keep the operative lines in the rule and move the rest into the skill it "
                "points at (see the harness-authoring skill)")
    return hits


def lint_staged(root: Path) -> List[str]:
    out = subprocess.run(["git", "-C", str(root), "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                         capture_output=True, text=True, timeout=10)
    files = [root / f for f in out.stdout.split() if (root / f).is_file()]
    return lint_files(root, files)


def cmd_lint(args: argparse.Namespace) -> int:
    root = Path(args.path).resolve() if args.path else REPO
    if getattr(args, "staged", False):
        hits = lint_staged(root)
        scope = "staged files"
    else:
        hits = lint_tree(root)
        scope = str(root)
    hits = hits + check_context_cap(root)
    for h in hits:
        say(h)
    everywhere, _ = load_lint_terms()
    note = "" if everywhere else " (no personal lint-terms file; shapes and secrets only)"
    say(f"lint: {len(hits)} finding(s) in {scope}{note}")
    return 1 if hits else 0


def cmd_workspace(args: argparse.Namespace) -> int:
    if args.action != "create":
        raise SystemExit("workspace: only `create` is supported")
    name = args.name
    folders = [str(Path(f).expanduser().resolve()) for f in args.folders]
    if not folders:
        raise SystemExit("workspace create needs at least one folder; the first is the root")
    if not args.no_harness and str(REPO) not in folders:
        folders.append(str(REPO))
    out = Path.cwd() / f"{name}.code-workspace"
    if out.exists() and not args.force:
        raise SystemExit(f"{out} exists; pass --force to overwrite")
    template = (REPO / "vscode" / "workspace.template.code-workspace").read_text(encoding="utf-8")
    body = template.replace("__FOLDERS__", json.dumps([{"path": f} for f in folders], indent=2))
    out.write_text(body, encoding="utf-8")
    say(f"wrote {out}")
    # Session store keyed off the first folder; one store, symlinked from every possible root key.
    projects = claude_dir() / "projects"
    stores = claude_dir() / "workspaces"
    store = stores / name
    store.mkdir(parents=True, exist_ok=True)
    (store / "memory").mkdir(exist_ok=True)
    projects.mkdir(parents=True, exist_ok=True)
    for f in folders:
        key = projects / f.replace("/", "-")
        if key.is_symlink():
            continue
        if key.exists():
            say(f"  {key} already holds history; leaving it alone (see docs/workspaces.md to merge it)")
            continue
        os.symlink(os.path.relpath(store, projects), key)
        say(f"  session key {key.name} -> workspaces/{name}")
    say(f"open with: code {out}")
    return 0


def _run(cmd: List[str], dry: bool) -> None:
    say("  $ " + " ".join(cmd))
    if not dry:
        subprocess.run(cmd, check=False)


def cmd_install(args: argparse.Namespace) -> int:
    dry = args.dry_run
    mac = platform.system() == "Darwin"
    say(f"agent-harness install{' (dry run)' if dry else ''}")
    if mac and not args.no_brew:
        if not shutil.which("xcode-select") or subprocess.run(["xcode-select", "-p"], capture_output=True).returncode != 0:
            say("  Xcode Command Line Tools missing: run `xcode-select --install`, then re-run")
            return 1
        if not shutil.which("brew"):
            _run(["/bin/bash", "-c", 'curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | bash'], dry)
        _run(["brew", "install"] + BREW_PACKAGES, dry)
    if mac and not args.no_apps and not args.no_vscode:
        if not shutil.which("code"):
            _run(["brew", "install", "--cask", "visual-studio-code"], dry)
        for f in ["extensions.txt"] + (["extensions.optional.txt"] if args.with_optional else []):
            for ext in (REPO / "vscode" / f).read_text().split():
                _run(["code", "--install-extension", ext, "--force"], dry)
    if not args.no_apps:
        if not shutil.which("claude"):
            _run(["/bin/bash", "-c", "curl -fsSL https://claude.ai/install.sh | bash"], dry)
        if not args.no_codex and not shutil.which("codex"):
            _run(["npm", "install", "-g", "@openai/codex"], dry)
    sync_args = argparse.Namespace(dry_run=dry, adopt=args.adopt, adopt_codex=args.adopt_codex, print_only=False)
    rc = cmd_sync(sync_args)
    say("\nLogins (interactive, cannot be automated):")
    say("  claude   — run `claude` and complete the browser login" if not (claude_dir() / ".credentials.json").exists() else "  claude   — credentials present")
    say("  codex    — run `codex login`" if not (codex_dir() / "auth.json").exists() else "  codex    — credentials present")
    say("  gh       — run `gh auth login`" if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0 else "  gh       — logged in")
    return rc


def cmd_config(args: argparse.Namespace) -> int:
    cfg = load_config()
    node: Any = cfg
    for part in args.key.split("."):
        if not isinstance(node, dict) or part not in node:
            raise SystemExit(f"no such key: {args.key}")
        node = node[part]
    say(node if isinstance(node, str) else json.dumps(node))
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    """Summarize the session records the usage-log hook writes. Local file only."""
    path = state_dir() / "usage.jsonl"
    if getattr(args, "rescan", False):
        hook = REPO / "claude" / "hooks" / "usage-log.py"
        out = subprocess.run([sys.executable, str(hook), "--rescan", str(args.days)], capture_output=True, text=True)
        say((out.stdout or out.stderr).strip() or "rescan found no transcripts")
    cutoff = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - max(args.days, 0) * 86400))
    groups: Dict[str, List[int]] = {}
    for line in (path.read_text(encoding="utf-8").splitlines() if path.exists() else []):
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict) or (row.get("ended") or "") < cutoff:
            continue
        if args.by == "repo":
            key = row.get("repo") or "(no repo)"
        elif args.by == "model":
            key = "+".join(row.get("models") or []) or "(unknown)"
        else:
            key = (row.get("ended") or "")[:10]
        acc = groups.setdefault(key, [0, 0, 0, 0, 0])
        acc[0] += 1
        for i, name in enumerate(("input", "output", "cache_read", "cache_write")):
            try:
                acc[i + 1] += int(row.get(name) or 0)
            except (TypeError, ValueError):
                pass
    if not groups:
        say(f"no sessions recorded in the last {args.days} day(s); looked in {path}")
        return 0

    def line_for(label: str, acc: List[int]) -> str:
        served = acc[1] + acc[3] + acc[4]
        hit = acc[3] / served if served else 0.0
        return (f"{label[:34]:<34}{acc[0]:>9}{acc[1]:>12,}{acc[2]:>12,}"
                f"{acc[3]:>14,}{acc[4]:>14,}{hit:>7.0%}")

    head = (f"{args.by:<34}{'sessions':>9}{'input':>12}{'output':>12}"
            f"{'cache_read':>14}{'cache_write':>14}{'hit':>7}")
    say(head)
    say("-" * len(head))
    total = [0, 0, 0, 0, 0]
    for key in sorted(groups):
        total = [t + a for t, a in zip(total, groups[key])]
        say(line_for(key, groups[key]))
    say("-" * len(head))
    say(line_for("TOTAL", total))
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="harness", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"agent-harness {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("install", help="full setup on a fresh machine, then sync")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-brew", action="store_true")
    p.add_argument("--no-apps", action="store_true")
    p.add_argument("--no-vscode", action="store_true")
    p.add_argument("--no-codex", action="store_true")
    p.add_argument("--with-optional", action="store_true", help="also install vscode/extensions.optional.txt")
    p.add_argument("--adopt", action="store_true", help="move pre-existing files aside so the harness can link")
    p.add_argument("--adopt-codex", action="store_true")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("sync", help="link the harness into ~/.claude and merge owned settings")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--adopt", action="store_true", help="move pre-existing files aside so the harness can link")
    p.add_argument("--adopt-codex", action="store_true", help="move a hand-written ~/.codex/AGENTS.md to AGENTS.personal.md")
    p.set_defaults(func=cmd_sync, print_only=False)

    p = sub.add_parser("diff", help="report drift between checkout, last sync and live files")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_diff)

    p = sub.add_parser("doctor", help="versions, logins, links, drift")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("uninstall", help="remove links and owned settings, restore adopted files")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("lint", help="scan for personal-data shapes, lint terms, secret patterns, and the context cap")
    p.add_argument("path", nargs="?")
    p.add_argument("--staged", action="store_true", help="only the files staged in git (used by the pre-commit hook)")
    p.set_defaults(func=cmd_lint)

    p = sub.add_parser("usage", help="summarize recorded session tokens and cache hit rate")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("--by", choices=["day", "repo", "model"], default="day")
    p.add_argument("--rescan", action="store_true", help="re-read transcripts from the window first, then report")
    p.set_defaults(func=cmd_usage)

    p = sub.add_parser("workspace", help="create a multi-root workspace with a shared session store")
    p.add_argument("action")
    p.add_argument("name")
    p.add_argument("folders", nargs="*")
    p.add_argument("--no-harness", action="store_true")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_workspace)

    p = sub.add_parser("config", help="print a resolved config value, e.g. `config get identity.name`")
    p.add_argument("action")
    p.add_argument("key")
    p.set_defaults(func=cmd_config)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
