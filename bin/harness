    "bypass": {"claude": "bypassPermissions", "vscode": "bypassPermissions", "codex": ("never", "danger-full-access")},
    "auto": {"claude": "auto", "vscode": None, "codex": ("on-request", "workspace-write")},
    "manual": {"claude": "default", "vscode": "default", "codex": ("on-request", "read-only")},
}
