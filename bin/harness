# The lint carries NO list of real personal values. A denylist of real values is itself a
# disclosure the moment it is committed, which is exactly how the first release of this tool
# leaked identifiers. Instead:
#   - SHAPES below catch the classes of personal data by pattern, everywhere in the tree,
#     including this file and the tests;
#   - the maintainer's name and handle are derived from LICENSE and CODEOWNERS at run time and
#     are allowed in repo metadata but never inside installed content;
#   - specific terms (employer, town, hostnames, account ids) come from an untracked file,
#     ~/.config/agent-harness/lint-terms.txt, or the HARNESS_LINT_TERMS environment variable.
SHAPE_PATTERNS = [
    ("12-digit account id", r"(?<![\w.-])\d{12}(?![\w.-])"),
    ("email address", r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+"),
    ("home-directory path", r"/(?:Users|home)/[A-Za-z0-9._-]+/"),
    ("cloud ARN with account", r"arn:aws:[a-z0-9-]*:[a-z0-9-]*:\d{12}"),
    ("hosted-zone id", r"\bZ[0-9A-Z]{13,31}\b"),
    ("identity-provider tenant", r"\b[a-z0-9-]+\.(?:us|eu|au|jp)\.auth0\.com\b|\bdev-[a-z0-9]{16}\b"),
    ("private IPv4 address", r"\b(?:10|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}(?:\.\d{1,3})?\b"),
]


def load_posture(root: Path = REPO):
    """The stance and cost resolver the hooks run, or None when it is missing.

    One loader, in `harness_core.catalog`, so the CLI, the lint and an isolated role worker all
    hold the same module: lint validates sidecars with the resolver's own schema, never a second
    copy of it.
    """
    return primitive_catalog.posture_module(root)


def load_detectors(root: Path = REPO):
    """The rule-detector registry from `root`'s checkout, or None when it has none.

    The registry is the single source of both `SECRET_PATTERNS` and the rule-coverage
    check, so the lint and the detector can never drift apart.
    """
    import importlib.util

    path = root / "claude" / "hooks" / "rule-detectors.py"
    if not path.is_file():
        return None
    try:
        spec = importlib.util.spec_from_file_location("harness_rule_detectors", str(path))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except Exception:
        return None


# Secret shapes live in claude/hooks/rule-detectors.py; the lint and the detector share one list.
SECRET_PATTERNS = getattr(load_detectors(), "SECRET_PATTERNS", [])
# Everything in `claude/CLAUDE.md`, `claude/rules/` and one variant of every stance is re-read on
# every turn of every session, so its size is a standing tax on every task. The cap is enforced by
# `harness lint`; the stance count uses the LONGEST variant of each dimension, so no selection a
# user can make is ever over it. Rationale: docs/how-it-works.md.
ALWAYS_LOADED_CAP = 200

NAME_FORBIDDEN_DIRS = {"claude", "vscode", "codex", "templates", "primitives", "adapters"}
NAME_FORBIDDEN_FILES = {"config.example.json"}
LINT_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".pytest_cache"}


def lint_terms_path() -> Path:
    return home() / ".config" / "agent-harness" / "lint-terms.txt"


def load_lint_terms(env: Optional[Dict[str, str]] = None) -> Tuple[List[str], List[str]]:
    """Returns (terms forbidden everywhere, terms allowed only under docs/), lower-cased."""
    env = os.environ if env is None else env
    everywhere: List[str] = []
    docs_ok: List[str] = []
    lines: List[str] = []
    if lint_terms_path().exists():
        lines += lint_terms_path().read_text(encoding="utf-8").splitlines()
    lines += [t for t in env.get("HARNESS_LINT_TERMS", "").split(",")]
    for raw in lines:
        t = raw.strip()
        if not t or t.startswith("#"):
            continue
        if t.lower().startswith("docs-ok:"):
            docs_ok.append(t[len("docs-ok:"):].strip().lower())
        else:
            everywhere.append(t.lower())
    return everywhere, docs_ok


def maintainer_terms(root: Path) -> List[str]:
    """Name tokens from the LICENSE copyright line and the handle from CODEOWNERS."""
    terms: List[str] = []
    lic = root / "LICENSE"
    if lic.exists():
        for line in lic.read_text(encoding="utf-8").splitlines():
            m = re.match(r"\s*Copyright \(c\) \d{4}\s+(.+)", line)
            if m:
                terms += [w for w in re.findall(r"[A-Za-z][A-Za-z'-]{2,}", m.group(1))]
                break
    co = root / ".github" / "CODEOWNERS"
    if co.exists():
        terms += re.findall(r"@([A-Za-z0-9-]+)", co.read_text(encoding="utf-8"))
    return sorted(set(terms))


