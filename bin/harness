    return home() / ".local" / "state" / "agent-harness"


def manifest_path() -> Path:
    return state_dir() / "manifest.json"


def applied_path() -> Path:
    return state_dir() / "applied.json"


def trusted_path() -> Path:
    """Repository roots whose `## Gate` block the stop-gate hook may run, one per line."""
    return home() / ".config" / "agent-harness" / "trusted.txt"


